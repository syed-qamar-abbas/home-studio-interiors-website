---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import { agencyAttribution, services, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  jsonLd?: object | object[];
}
const {
  title = `${site.name} — Interior Designers in Islamabad`,
  description = 'Full home interior design in Islamabad & Rawalpindi — kitchens, wardrobes, vanities, media walls and doors. 3D design, premium materials and turnkey delivery.',
  image = `${site.url}/og-default.jpg`,
  path = Astro.url.pathname,
  jsonLd,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const absoluteImage = new URL(image, site.url).href;
const agencyBaseUrl = agencyAttribution.agencyUrl.replace(/\/$/, '');
const agencySlug = agencyAttribution.clientSlug.trim().replace(/^\/+|\/+$/g, '');
const agencyHref =
  agencyAttribution.attributionType === 'portfolio' && agencySlug
    ? `${agencyBaseUrl}/portfolio/${agencySlug}`
    : agencyAttribution.attributionType === 'case-study' && agencySlug
      ? `${agencyBaseUrl}/case-studies/${agencySlug}`
      : agencyAttribution.agencyUrl;
const agencyEntityId = agencyAttribution.entityId || `${agencyBaseUrl}/#organization`;
const verifiedSameAs = Object.values(site.socials).filter((url) => url && !/^https:\/\/(facebook|instagram|linkedin|pinterest)\.com\/?$/i.test(url));
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${site.url}/#business`,
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  logo: new URL('/images/brand/hs-logo-cropped-260.webp', site.url).href,
  image: absoluteImage,
  description,
  telephone: site.phoneIntl,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Islamabad', addressRegion: 'ICT', addressCountry: 'PK' },
  areaServed: site.areaServed.map((area) => ({ '@type': 'City', name: area, addressCountry: 'PK' })),
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phoneIntl,
    contactType: 'customer service',
    areaServed: 'PK',
    availableLanguage: ['English', 'Urdu'],
  },
  knowsAbout: [
    'Residential interior design',
    'Kitchen design',
    'Modular kitchens',
    'Wardrobe design',
    'Media wall design',
    'Bathroom vanities',
    'Interior doors',
    'Home remodeling',
    'Islamabad interiors',
    'Rawalpindi interiors',
  ],
  makesOffer: services.map((service) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: service.title,
      description: service.excerpt,
      url: `${site.url}/services/${service.slug}`,
    },
  })),
  ...(verifiedSameAs.length ? { sameAs: verifiedSameAs } : {}),
  priceRange: '$$',
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  creator: { '@id': agencyEntityId },
  copyrightHolder: { '@id': `${site.url}/#business` },
  publisher: { '@id': `${site.url}/#business` },
  inLanguage: 'en-PK',
};
const agencyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': agencyEntityId,
  name: agencyAttribution.agencyName,
  url: agencyAttribution.agencyUrl,
  logo: new URL(agencyAttribution.logo, site.url).href,
  ...(agencyHref !== agencyAttribution.agencyUrl ? { subjectOf: { '@type': 'CreativeWork', url: agencyHref } } : {}),
  ...(agencyAttribution.sameAs.length ? { sameAs: agencyAttribution.sameAs } : {}),
  ...(agencyAttribution.contact.email ? { email: agencyAttribution.contact.email } : {}),
  ...(agencyAttribution.contact.telephone ? { telephone: agencyAttribution.contact.telephone } : {}),
  ...(agencyAttribution.founder ? { founder: { '@type': 'Person', name: agencyAttribution.founder } } : {}),
};
const schema = [
  websiteJsonLd,
  baseJsonLd,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  agencyJsonLd,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable site context" />
    <link rel="alternate" type="text/markdown" href="/pricing.md" title="Pricing guidance" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap"
      />
    </noscript>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F27025" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(w,d,id){
        var load=function(){
          if(w.__hsClarityLoaded) return;
          w.__hsClarityLoaded=true;
          w.clarity=w.clarity||function(){(w.clarity.q=w.clarity.q||[]).push(arguments)};
          var s=d.createElement("script");
          s.async=true;
          s.src="https://www.clarity.ms/tag/"+id;
          var first=d.getElementsByTagName("script")[0];
          first.parentNode.insertBefore(s,first);
        };
        if("requestIdleCallback" in w) {
          w.requestIdleCallback(load,{timeout:2500});
        } else {
          w.addEventListener("load",function(){setTimeout(load,1200)},{once:true});
        }
      })(window,document,"ynqgn37p2j");
    </script>
  </head>
  <body>
    <div class="bg-orbs" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="ambient-interiors" aria-hidden="true">
      <span class="ambient-line ambient-line-a"></span>
      <span class="ambient-line ambient-line-b"></span>
      <span class="ambient-line ambient-line-c"></span>
      <span class="ambient-dot ambient-dot-a"></span>
      <span class="ambient-dot ambient-dot-b"></span>
      <span class="ambient-dot ambient-dot-c"></span>
      <span class="ambient-dot ambient-dot-d"></span>
    </div>
    <div class="lux-cursor" aria-hidden="true">
      <span class="lux-cursor-ring"></span>
      <span class="lux-cursor-dot"></span>
    </div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:bg-ink focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <div class="fixed inset-x-3 bottom-3 z-50 grid grid-cols-2 gap-2 rounded-full border border-white/10 bg-graphite/88 p-2 shadow-[0_22px_70px_-30px_rgba(0,0,0,.9)] backdrop-blur-xl md:hidden" aria-label="Quick contact">
      <a href={`tel:${site.phoneIntl}`} class="rounded-full border border-white/12 px-4 py-3 text-center text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white">Call</a>
      <a href="/contact" data-open-quote class="rounded-full bg-accent px-4 py-3 text-center text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-white">Get Quote</a>
    </div>
    <div id="lightbox" class="fixed inset-0 z-[80] hidden bg-black/92 p-4 text-white backdrop-blur-md" aria-hidden="true">
      <button type="button" data-lightbox-close class="absolute right-5 top-5 z-10 grid h-11 w-11 place-items-center rounded-full border border-white/20 text-2xl text-white/80 transition-colors hover:border-accent hover:text-accent" aria-label="Close image">×</button>
      <button type="button" data-lightbox-prev class="absolute left-5 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/20 text-2xl text-white/80 transition-colors hover:border-accent hover:text-accent md:grid" aria-label="Previous image">‹</button>
      <button type="button" data-lightbox-next class="absolute right-5 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/20 text-2xl text-white/80 transition-colors hover:border-accent hover:text-accent md:grid" aria-label="Next image">›</button>
      <div class="flex h-full items-center justify-center">
        <figure class="w-full max-w-6xl">
          <img data-lightbox-image src="" alt="" class="mx-auto max-h-[78vh] w-auto rounded-2xl object-contain" />
          <figcaption class="mx-auto mt-5 flex max-w-4xl flex-col justify-between gap-4 text-center md:flex-row md:items-center md:text-left">
            <span data-lightbox-caption class="font-display text-2xl"></span>
            <a data-lightbox-whatsapp href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} class="btn btn-solid justify-center">Discuss this design</a>
          </figcaption>
        </figure>
      </div>
    </div>
    <QuoteModal />
    <Footer />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
