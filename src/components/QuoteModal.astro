---
import Icon from './Icon.astro';
import { site } from '../data/site';

const whatsappNumber = site.whatsapp.replace(/\D/g, '');
const projectOptions = [
  ['Full Kitchen Redesign & Installation', 'full_kitchen_redesign_and_installation'],
  ['New Kitchen for a New Home', 'new_kitchen_for_a_new_home'],
  ['Just Exploring Ideas for the Future', 'just_exploring_ideas_for_the_future'],
  ['Full Home Remodeling', 'full_home_remodeling'],
];
const budgetOptions = [
  ['PKR 3–5 Lacs — Basic', 'pkr_3_to_5_lacs_basic'],
  ['PKR 7–10 Lacs — Standard', 'pkr_7_to_10_lacs_standard'],
  ['PKR 10–20 Lacs — Premium', 'pkr_10_to_20_lacs_premium'],
  ['PKR 20 Lacs+ — Luxury', 'pkr_20_lacs_plus_luxury'],
];
const timelineOptions = [
  ['Immediately — Within 1 Month', 'immediately_within_1_month'],
  ['In 1–3 Months', 'in_1_to_3_months'],
  ['In 3–6 Months', 'in_3_to_6_months'],
  ['Flexible / Unsure', 'flexible_or_unsure'],
];
---

<div id="quote-modal" class="quote-modal fixed inset-0 z-[90] hidden items-center justify-center p-3 text-white sm:p-5" aria-hidden="true">
  <button type="button" class="absolute inset-0 bg-black/72 backdrop-blur-md" data-quote-close aria-label="Close quote form"></button>

  <section class="quote-panel relative max-h-[92svh] w-full max-w-3xl overflow-hidden rounded-[1.6rem] border border-white/12 bg-graphite/94 shadow-[0_36px_120px_-44px_rgba(0,0,0,.95)]">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_0%,rgba(242,112,37,.18),transparent_34%),linear-gradient(135deg,rgba(255,255,255,.06),transparent_42%)]"></div>
    <div class="relative flex max-h-[92svh] flex-col overflow-y-auto p-5 sm:p-7 md:p-8">
      <div class="flex items-start justify-between gap-5">
        <div>
          <p class="section-kicker">Get a quote</p>
          <h2 class="mt-4 font-display text-3xl text-white md:text-4xl">Tell us about your project.</h2>
          <p class="mt-3 max-w-xl text-sm leading-7 text-muted">A short quotation form so our team can guide you with the right scope, budget and next step.</p>
        </div>
        <button type="button" class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-white/15 text-2xl text-white/70 transition hover:border-accent hover:text-accent" data-quote-close aria-label="Close quote form">×</button>
      </div>

      <form id="quote-form" class="mt-7 space-y-7" novalidate data-whatsapp-number={whatsappNumber}>
        <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="flex items-center gap-3" aria-label="Quote form progress">
          {[1, 2, 3, 4].map((step) => (
            <span class={`h-1.5 flex-1 rounded-full bg-white/10 transition-colors duration-300 ${step === 1 ? 'bg-accent' : ''}`} data-quote-progress={step}></span>
          ))}
        </div>

        <div class="min-h-[24rem]">
          <fieldset class="quote-step space-y-5" data-quote-step="1">
            <legend class="font-display text-2xl text-white">Your details</legend>
            <div class="grid gap-5 sm:grid-cols-2">
              <label>
                <span class="eyebrow text-muted">Full Name</span>
                <input required name="full_name" type="text" autocomplete="name" minlength="2" maxlength="80" class="mt-2 w-full rounded-xl border border-line bg-white/[0.035] px-4 py-3 text-white outline-none transition focus:border-accent" />
              </label>
              <label>
                <span class="eyebrow text-muted">Phone Number</span>
                <input required name="phone_number" type="tel" inputmode="tel" autocomplete="tel" pattern="^(?:\\+92|0)3\\d{9}$" placeholder="03001234567" class="mt-2 w-full rounded-xl border border-line bg-white/[0.035] px-4 py-3 text-white outline-none transition focus:border-accent" />
              </label>
            </div>
            <label class="block">
              <span class="eyebrow text-muted">Email Address</span>
              <input required name="email" type="email" autocomplete="email" maxlength="120" class="mt-2 w-full rounded-xl border border-line bg-white/[0.035] px-4 py-3 text-white outline-none transition focus:border-accent" />
            </label>
            <p class="text-xs leading-6 text-muted">Pakistani phone formats supported: 03001234567 and +923001234567.</p>
          </fieldset>

          <fieldset class="quote-step hidden space-y-5" data-quote-step="2">
            <legend class="font-display text-2xl text-white">What best describes your project?</legend>
            <div class="grid gap-3">
              {projectOptions.map(([label, value]) => (
                <label class="qual-card">
                  <input required type="radio" name="what_best_describes_your_project" value={value} data-label={label} class="sr-only" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-step hidden space-y-5" data-quote-step="3">
            <legend class="font-display text-2xl text-white">What is your estimated budget for your kitchen?</legend>
            <div class="grid gap-3">
              {budgetOptions.map(([label, value]) => (
                <label class="qual-card">
                  <input required type="radio" name="what_is_your_estimated_budget_for_your_kitchen" value={value} data-label={label} class="sr-only" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="quote-step hidden space-y-5" data-quote-step="4">
            <legend class="font-display text-2xl text-white">How soon are you looking to start your project?</legend>
            <div class="grid gap-3">
              {timelineOptions.map(([label, value]) => (
                <label class="qual-card">
                  <input required type="radio" name="how_soon_are_you_looking_to_start_your_project" value={value} data-label={label} class="sr-only" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <p class="hidden rounded-2xl border px-4 py-3 text-sm leading-6" data-quote-message></p>

        <div class="flex flex-col gap-3 sm:flex-row">
          <button type="button" class="btn btn-ghost justify-center sm:w-auto" data-quote-back>Back</button>
          <button type="button" class="btn btn-solid flex-1 justify-center" data-quote-next>Continue <Icon name="arrow" size={14} class="arrow" /></button>
          <button type="submit" class="btn btn-solid hidden flex-1 justify-center" data-quote-submit>Request My Quote</button>
        </div>
      </form>
    </div>
  </section>
</div>

<script is:inline>
  (function () {
    var modal = document.getElementById('quote-modal');
    var form = document.getElementById('quote-form');
    if (!modal || !form) return;

    var current = 1;
    var total = 4;
    var submitting = false;
    var back = form.querySelector('[data-quote-back]');
    var next = form.querySelector('[data-quote-next]');
    var submit = form.querySelector('[data-quote-submit]');
    var message = form.querySelector('[data-quote-message]');
    var whatsappBase = 'https://wa.me/' + (form.getAttribute('data-whatsapp-number') || '');

    function clean(value) {
      return String(value || '').replace(/[<>]/g, '').replace(/\s+/g, ' ').trim();
    }
    function showMessage(type, text) {
      message.textContent = text;
      message.classList.remove('hidden', 'border-red-500/35', 'bg-red-500/10', 'text-red-100', 'border-accent/35', 'bg-accent/10', 'text-white');
      if (type === 'error') message.classList.add('border-red-500/35', 'bg-red-500/10', 'text-red-100');
      else message.classList.add('border-accent/35', 'bg-accent/10', 'text-white');
    }
    function hideMessage() {
      message.classList.add('hidden');
      message.textContent = '';
    }
    function stepEl(step) {
      return form.querySelector('[data-quote-step="' + step + '"]');
    }
    function setStep(step) {
      current = Math.max(1, Math.min(total, step));
      Array.from(form.querySelectorAll('[data-quote-step]')).forEach(function (el) {
        el.classList.toggle('hidden', el.getAttribute('data-quote-step') !== String(current));
      });
      Array.from(form.querySelectorAll('[data-quote-progress]')).forEach(function (el) {
        var on = Number(el.getAttribute('data-quote-progress')) <= current;
        el.classList.toggle('bg-accent', on);
        el.classList.toggle('bg-white/10', !on);
      });
      back.toggleAttribute('disabled', current === 1);
      back.classList.toggle('opacity-40', current === 1);
      next.classList.toggle('hidden', current === total);
      submit.classList.toggle('hidden', current !== total);
      hideMessage();
    }
    function validateStep(step) {
      var scope = stepEl(step);
      var fields = Array.from(scope.querySelectorAll('input[required]'));
      for (var i = 0; i < fields.length; i++) {
        var field = fields[i];
        if (field.type === 'radio') {
          if (!scope.querySelector('input[name="' + field.name + '"]:checked')) {
            showMessage('error', 'Please select one option to continue.');
            return false;
          }
          return true;
        }
        field.value = clean(field.value);
        if (field.name === 'phone_number' && !/^(?:\+92|0)3\d{9}$/.test(field.value)) {
          showMessage('error', 'Phone Number must be like 03001234567 or +923001234567.');
          field.focus();
          return false;
        }
        if (!field.checkValidity()) {
          var label = field.closest('label')?.querySelector('.eyebrow')?.textContent || 'This field';
          showMessage('error', label + ' is required or invalid.');
          field.focus();
          return false;
        }
      }
      return true;
    }
    function selectedLabel(name) {
      var input = form.querySelector('input[name="' + name + '"]:checked');
      return input ? clean(input.getAttribute('data-label') || input.value) : '';
    }
    function openModal(event) {
      if (event) event.preventDefault();
      modal.classList.remove('hidden');
      modal.classList.add('flex', 'is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setStep(1);
      setTimeout(function () {
        var first = form.querySelector('input[name="full_name"]');
        if (first) first.focus();
      }, 120);
    }
    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex', 'is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('[data-open-quote]').forEach(function (trigger) {
      trigger.addEventListener('click', openModal);
    });
    modal.querySelectorAll('[data-quote-close]').forEach(function (trigger) {
      trigger.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
    next.addEventListener('click', function () {
      if (validateStep(current)) setStep(current + 1);
    });
    back.addEventListener('click', function () {
      if (current > 1) setStep(current - 1);
    });
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (submitting) return;
      if (!validateStep(current)) return;
      if (form.website && form.website.value) return;

      submitting = true;
      submit.setAttribute('disabled', 'true');
      submit.textContent = 'Preparing quote...';
      hideMessage();

      var fullName = clean(form.full_name.value);
      var phone = clean(form.phone_number.value);
      var email = clean(form.email.value);
      var projectType = selectedLabel('what_best_describes_your_project');
      var budget = selectedLabel('what_is_your_estimated_budget_for_your_kitchen');
      var timeline = selectedLabel('how_soon_are_you_looking_to_start_your_project');

      var whatsappMessage = [
        'NEW PROJECT QUOTE REQUEST',
        '',
        'CLIENT DETAILS',
        '',
        'Name: ' + fullName,
        'Phone: ' + phone,
        'Email: ' + email,
        '',
        'PROJECT DETAILS',
        '',
        'Project Type: ' + projectType,
        'Estimated Budget: ' + budget,
        'Expected Start: ' + timeline,
        '',
        'Source: Home Studio Interiors Website',
      ].join('\n');

      setTimeout(function () {
        window.open(whatsappBase + '?text=' + encodeURIComponent(whatsappMessage), '_blank', 'noopener');
        showMessage('success', 'WhatsApp is opening with your quote request. Please send the message to complete it.');
        submitting = false;
        submit.removeAttribute('disabled');
        submit.textContent = 'Request My Quote';
      }, 250);
    });

    setStep(1);
  })();
</script>
