---
import { site } from '../data/site';
interface Props { title?: string; text?: string; }
const {
  title = 'Ready to transform your space?',
  text = 'Work with an interior designer in Islamabad — concept → 3D → turnkey handover, on time and on budget.',
} = Astro.props;
---
<section class="relative overflow-hidden bg-accent py-24 text-white md:py-32">
  <div class="container-page text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/80" data-reveal>Let's begin</p>
    <h2 class="display-lg mx-auto mt-6 max-w-3xl text-white" data-reveal>{title}</h2>
    <p class="mx-auto mt-6 max-w-xl text-white/85" data-reveal>{text}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4" data-reveal>
      <a href="/contact" data-open-quote class="btn border-white bg-white text-accent hover:bg-ink hover:border-ink hover:text-white">Get a Quote</a>
      <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} class="btn btn-ghost border-white text-white hover:bg-white hover:text-accent">WhatsApp Us</a>
    </div>
  </div>
</section>
