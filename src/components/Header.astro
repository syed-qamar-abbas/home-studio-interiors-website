---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
const current = Astro.url.pathname;
const servicePreview = [
  { label: 'Kitchens', href: '/services/kitchen', image: '/images/services/kitchen-live/09-1-18.webp' },
  { label: 'Wardrobes', href: '/services/wardrobe', image: '/images/services/wardrobe-live/01-1-8.webp' },
  { label: 'Vanities', href: '/services/vanities', image: '/images/services/vanities-live/01-3-1024x574.webp' },
  { label: 'Media Walls', href: '/services/media-walls', image: '/images/services/media-walls-live/01-photo-stylish-wallmounted-entertainment-1024x574.webp' },
  { label: 'Doors', href: '/services/doors', image: '/images/services/doors-live/01-coastal-interior-design-modern-entrance-hall-1-1024x574.webp' },
];
---
<header id="site-header" class="fixed top-0 left-0 z-40 w-full transition-all duration-500" data-header>
  <div class="container-page flex items-center justify-between py-4">
    <a href="/" aria-label={`${site.name} home`} class="block">
      <img src="/images/brand/hs-logo-cropped.png" alt="Home Studio Interiors" class="h-10 w-auto object-contain md:h-12" width="940" height="639" />
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label="Primary">
      {nav.map((item) => (
        <div class="group relative">
          <a href={item.href} class:list={["link-underline text-[0.82rem] font-medium uppercase tracking-[0.14em]", current === item.href ? "text-accent" : "text-white/90 hover:text-white"]} data-navlink>{item.label}</a>
          {item.children && (
            <div class="invisible absolute left-1/2 top-full z-10 mt-4 w-[44rem] -translate-x-1/2 translate-y-2 rounded-[1.35rem] border border-white/10 bg-graphite/95 p-3 opacity-0 shadow-[0_30px_80px_-35px_rgba(0,0,0,0.8)] backdrop-blur-xl transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              <div class="grid grid-cols-5 gap-2">
                {servicePreview.map((c) => (
                  <a href={c.href} class="group/card overflow-hidden rounded-2xl border border-white/8 bg-white/[0.035] p-2 transition-all duration-300 hover:border-accent/50 hover:bg-accent/10">
                    <img src={c.image} alt="" loading="lazy" class="h-20 w-full rounded-xl object-cover opacity-75 transition duration-500 group-hover/card:scale-105 group-hover/card:opacity-100" />
                    <span class="mt-2 block text-center text-[0.64rem] font-semibold uppercase tracking-[0.14em] text-white/72 group-hover/card:text-white">{c.label}</span>
                  </a>
                ))}
              </div>
              <a href="/services" class="mt-2 flex items-center justify-between rounded-2xl border border-white/8 px-4 py-3 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-white/68 transition-colors hover:border-accent/50 hover:text-accent">
                View all services <Icon name="arrow" size={13} />
              </a>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-5">
      <a href={`tel:${site.phoneIntl}`} class="hidden items-center gap-2 text-sm font-medium tracking-wide text-white xl:flex"><Icon name="phone" size={16} class="text-accent" />{site.phone}</a>
      <a href="/contact" class="btn btn-cta hidden sm:inline-flex">Get in Touch <Icon name="arrow" size={14} class="arrow" /></a>
      <button id="menu-toggle" class="flex flex-col gap-1.5 lg:hidden" aria-label="Open menu" aria-expanded="false">
        <span class="block h-px w-7 bg-white transition-all"></span>
        <span class="block h-px w-7 bg-white transition-all"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-50 hidden bg-graphite text-white">
  <div class="container-page flex h-full flex-col">
    <div class="flex items-center justify-between py-4">
      <img src="/images/brand/hs-logo-cropped.png" alt="Home Studio Interiors" class="h-12 w-auto object-contain" />
      <button id="menu-close" class="text-4xl leading-none text-white" aria-label="Close menu">&times;</button>
    </div>
    <nav class="mt-8 flex flex-col gap-1 overflow-y-auto" aria-label="Mobile">
      {nav.map((item) => (
        <>
          <a href={item.href} class="border-b border-white/10 py-4 font-display text-3xl text-white">{item.label}</a>
          {item.children && (
            <div class="grid grid-cols-2 gap-3 border-b border-white/10 py-4">
              {servicePreview.map((c) => (
                <a href={c.href} class="rounded-2xl border border-white/10 bg-white/[0.04] p-2">
                  <img src={c.image} alt="" loading="lazy" class="h-20 w-full rounded-xl object-cover" />
                  <span class="mt-2 block text-xs uppercase tracking-[0.14em] text-white/70">{c.label}</span>
                </a>
              ))}
            </div>
          )}
        </>
      ))}
    </nav>
    <div class="mt-auto grid grid-cols-2 gap-3 py-8">
      <a href={`tel:${site.phoneIntl}`} class="btn btn-ghost justify-center text-white">Call</a>
      <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} class="btn btn-solid justify-center">WhatsApp</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var menu = document.getElementById('mobile-menu');
    var open = document.getElementById('menu-toggle');
    var close = document.getElementById('menu-close');
    if (open) open.addEventListener('click', function () { menu.classList.remove('hidden'); document.body.style.overflow = 'hidden'; });
    if (close) close.addEventListener('click', function () { menu.classList.add('hidden'); document.body.style.overflow = ''; });
    menu && menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { menu.classList.add('hidden'); document.body.style.overflow = ''; }); });
  })();
</script>

<style>
  /* Elegant dark bar on scroll so the white wordmark reads in every state */
  [data-header].is-scrolled { background: rgba(32, 29, 24, 0.96); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.08); }
  [data-header].is-scrolled .container-page { padding-block: 0.35rem; }

  .btn-cta { border: 1px solid rgba(255,255,255,0.55); color: #fff; }
  .btn-cta:hover { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  [data-header].is-scrolled .btn-cta { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  [data-header].is-scrolled .btn-cta:hover { background: var(--color-accent-dark); border-color: var(--color-accent-dark); }
</style>
