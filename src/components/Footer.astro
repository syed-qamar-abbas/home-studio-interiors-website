---
import { site, nav, services } from '../data/site';
import { areaPages, guideArticles, seoLandingPages } from '../data/seo';
import FooterAttribution from './FooterAttribution.astro';
const year = new Date().getFullYear();
const footerLocalPages = seoLandingPages.filter((page) =>
  ['interior-designers-islamabad', 'kitchen-design-islamabad', 'wardrobe-design-islamabad', 'interior-designers-rawalpindi'].includes(page.slug)
);
const footerGuides = [...guideArticles]
  .sort((a, b) => new Date(b.updated).getTime() - new Date(a.updated).getTime())
  .slice(0, 5);
---
<footer class="bg-graphite text-white">
  <div class="container-page py-20">
    <div class="grid gap-14 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <img src="/images/brand/hs-logo-cropped-260.webp" alt="Home Studio Interiors" class="h-14 w-auto object-contain md:h-16" width="260" height="177" loading="lazy" decoding="async" />
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/60">
          A residential interior design studio in Islamabad — blending smart planning with warm materials to create homes that feel effortless and endure.
        </p>
      </div>

      <div>
        <h4 class="eyebrow text-accent">Explore</h4>
        <ul class="mt-6 space-y-3">
          {nav.map((n) => (
            <li><a href={n.href} class="link-underline text-sm text-white/70 hover:text-white">{n.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="eyebrow text-accent">Services</h4>
        <ul class="mt-6 space-y-3">
          {services.map((s) => (
            <li><a href={`/services/${s.slug}`} class="link-underline text-sm text-white/70 hover:text-white">{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="eyebrow text-accent">Studio</h4>
        <ul class="mt-6 space-y-3 text-sm text-white/70">
          <li>{site.address}</li>
          <li><a href={`mailto:${site.email}`} class="link-underline hover:text-white">{site.email}</a></li>
          <li><a href={`tel:${site.phoneIntl}`} class="link-underline hover:text-white">{site.phone}</a></li>
        </ul>
        <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`} class="btn btn-ghost mt-7 border-white/25 text-white">WhatsApp Us</a>
      </div>
    </div>

    <div class="mt-14 grid gap-8 border-t border-white/[0.07] pt-10 lg:grid-cols-3">
      <div>
        <h4 class="eyebrow text-accent">Local visibility</h4>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          <li><a href="/service-areas" class="link-underline text-sm text-white/62 hover:text-white">Service Areas</a></li>
          {footerLocalPages.map((page) => (
            <li><a href={`/${page.slug}`} class="link-underline text-sm text-white/62 hover:text-white">{page.serviceName}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="eyebrow text-accent">Popular areas</h4>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {areaPages.slice(0, 6).map((page) => (
            <li><a href={`/service-areas/${page.slug}`} class="link-underline text-sm text-white/62 hover:text-white">{page.area}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="eyebrow text-accent">Helpful guides</h4>
        <ul class="mt-5 grid gap-3">
          <li><a href="/process" class="link-underline text-sm text-white/62 hover:text-white">How We Work</a></li>
          <li><a href="/faq" class="link-underline text-sm text-white/62 hover:text-white">FAQ</a></li>
          {footerGuides.map((article) => (
            <li><a href={`/blog/${article.slug}`} class="link-underline text-sm text-white/62 hover:text-white">{article.title}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-line-light pt-8 text-xs uppercase tracking-[0.16em] text-white/45 md:flex-row">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy-policy" class="hover:text-white">Privacy</a>
        <a href="/terms-condition" class="hover:text-white">Terms</a>
        <a href="/credits" class="hover:text-white">Credits</a>
        <p>{site.tagline}</p>
      </div>
    </div>

    <div class="mt-6 border-t border-white/[0.06] pt-5">
      <FooterAttribution />
    </div>
  </div>
</footer>
