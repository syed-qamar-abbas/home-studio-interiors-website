---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { heroImage } from '../data/site';

// Placeholder editorial topics — replace with real posts as they're published.
const topics = [
  { title: 'How much does interior design cost in Islamabad?', cat: 'Guides', img: '/images/feature-1.webp', text: 'Budget factors, BOQ clarity and where premium materials matter most.' },
  { title: 'Modern vs classic kitchens: what should you choose?', cat: 'Kitchens', img: '/images/services/kitchen-live/09-1-18.webp', text: 'A visual decision guide for cabinetry, surfaces, handles and lighting.' },
  { title: 'Sliding vs hinged wardrobes: storage planned well', cat: 'Wardrobes', img: '/images/services/wardrobe-live/01-1-8.webp', text: 'How to choose wardrobe systems around room size, lifestyle and finish.' },
  { title: 'Designing a media wall that hides the clutter', cat: 'Media Walls', img: '/images/services/media-walls-live/01-photo-stylish-wallmounted-entertainment-1024x574.webp', text: 'Cable planning, ventilation, lighting and decorative panel balance.' },
  { title: 'Quartz vs granite for kitchens and vanities', cat: 'Materials', img: '/images/services/vanities-live/04-5-1024x574.webp', text: 'A quick material guide for daily use, maintenance and visual warmth.' },
  { title: 'Veneer vs painted doors for modern interiors', cat: 'Doors', img: '/images/services/doors-live/07-BRISTOL-door-image.webp', text: 'Door finishes explained for durability, warmth and design continuity.' },
];
---
<Base title="Journal — Interior Design Ideas & Guides | Home Studio Interiors"
  description="Ideas, guides and inspiration on interior design, kitchens, wardrobes and home fit-outs in Islamabad & Rawalpindi.">
  <PageHero eyebrow="The journal" title="Ideas & inspiration."
    subtitle="Guides, material notes and design thinking from our studio — written to help you plan a home you'll love."
    image={heroImage} />

  <section class="container-page py-20 md:py-28">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {topics.map((t, i) => (
        <article class={`signature-card group overflow-hidden rounded-[1.6rem] border border-line bg-surface/55 ${i === 0 ? 'md:col-span-2' : ''}`} data-reveal>
          <div class="aspect-[16/10] overflow-hidden">
            <img src={t.img} alt={t.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105" />
          </div>
          <div class="p-6">
            <p class="number-mark">{t.cat}</p>
            <h2 class="mt-3 font-display text-3xl">{t.title}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">{t.text}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] text-accent">Coming soon <Icon name="arrow" size={13} /></span>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-16 text-center text-sm uppercase tracking-[0.2em] text-muted" data-reveal>More articles on the way</p>
  </section>

  <CtaBand />
</Base>
