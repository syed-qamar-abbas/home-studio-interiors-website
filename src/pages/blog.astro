---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { heroImage } from '../data/site';
import { guideArticles } from '../data/seo';

const sortedArticles = [...guideArticles].sort(
  (a, b) => new Date(b.updated).getTime() - new Date(a.updated).getTime()
);
---
<Base title="Journal — Interior Design Ideas & Guides | Home Studio Interiors"
  description="Ideas, guides and inspiration on interior design, kitchens, wardrobes and home fit-outs in Islamabad & Rawalpindi.">
  <PageHero eyebrow="The journal" title="Ideas & inspiration."
    subtitle="Guides, material notes and design thinking from our studio — written to help you plan a home you'll love."
    image={heroImage} />

  <section class="container-page py-20 md:py-28">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sortedArticles.map((article, i) => (
        <article class={`signature-card group overflow-hidden rounded-[1.6rem] border border-line bg-surface/55 ${i === 0 ? 'md:col-span-2' : ''}`} data-reveal>
          <div class="aspect-[16/10] overflow-hidden">
            <img src={article.image} alt={article.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105" />
          </div>
          <div class="p-6">
            <p class="number-mark">{article.category} · {article.readTime}</p>
            <h2 class="mt-3 font-display text-3xl">{article.title}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">{article.description}</p>
            <a href={`/blog/${article.slug}`} class="mt-5 inline-flex items-center gap-2 text-xs uppercase tracking-[0.16em] text-accent">Read guide <Icon name="arrow" size={13} /></a>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-16 text-center text-sm uppercase tracking-[0.2em] text-muted" data-reveal>Built for Google, AI answers and homeowner decisions</p>
  </section>

  <CtaBand />
</Base>
