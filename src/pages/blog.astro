---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { heroImage } from '../data/site';

// Placeholder editorial topics — replace with real posts as they're published.
const topics = [
  { title: 'How much does interior design cost in Islamabad?', cat: 'Guides', img: '/images/feature-1.webp' },
  { title: 'Modular vs. carpenter-built kitchens: what to choose', cat: 'Kitchens', img: '/images/kitchen-c.webp' },
  { title: 'Planning wardrobe storage to the millimetre', cat: 'Wardrobes', img: '/images/wardrobe-fill-2.webp' },
  { title: 'Designing a media wall that hides the clutter', cat: 'Media Walls', img: '/images/media-a.webp' },
];
---
<Base title="Journal — Interior Design Ideas & Guides | Home Studio Interiors"
  description="Ideas, guides and inspiration on interior design, kitchens, wardrobes and home fit-outs in Islamabad & Rawalpindi.">
  <PageHero eyebrow="The journal" title="Ideas & inspiration."
    subtitle="Guides, material notes and design thinking from our studio — written to help you plan a home you'll love."
    image={heroImage} />

  <section class="container-page py-28 md:py-36">
    <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-2">
      {topics.map((t) => (
        <article class="group" data-reveal>
          <div class="aspect-[16/10] overflow-hidden">
            <img src={t.img} alt={t.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105" />
          </div>
          <p class="eyebrow mt-6">{t.cat}</p>
          <h2 class="display-md mt-3 text-3xl">{t.title}</h2>
          <span class="link-underline mt-4 inline-block text-sm uppercase tracking-[0.16em] text-muted">Coming soon</span>
        </article>
      ))}
    </div>
    <p class="mt-16 text-center text-sm uppercase tracking-[0.2em] text-muted" data-reveal>More articles on the way</p>
  </section>

  <CtaBand />
</Base>
