---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, serviceTabs, processSteps, differentiators, deliverables, testimonials, faqs, heroImage, aboutImage, bandImage, heroFeatures, founder } from '../data/site';
const socials = [
  { name: 'instagram', href: site.socials.instagram },
  { name: 'facebook', href: site.socials.facebook },
  { name: 'pinterest', href: 'https://pinterest.com/' },
  { name: 'linkedin', href: site.socials.linkedin },
];
const statBar = [
  { num: 8, suffix: '+', value: '8+', label: 'Years of Experience', icon: 'award' },
  { num: 95, suffix: '+', value: '95+', label: 'Positive Feedback', icon: 'thumb' },
  { num: 2488, suffix: '+', value: '2,488+', label: 'Satisfied Clients', icon: 'users' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  image: heroImage,
  url: site.url,
  telephone: site.phoneIntl,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Islamabad', addressRegion: 'ICT', addressCountry: 'PK' },
  areaServed: site.areaServed,
  priceRange: '$$',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.value, reviewCount: site.rating.count },
};
---
<Base jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative min-h-screen overflow-hidden" data-cursor-glow>
    <div class="pointer-events-none absolute inset-0 z-0 hidden lg:block" style="background: radial-gradient(28rem 28rem at var(--gx, 25%) var(--gy, 35%), rgba(242,112,37,0.12), transparent 62%);"></div>
    <!-- vertical socials -->
    <div class="absolute left-0 top-0 z-30 hidden h-full w-14 flex-col items-center justify-center gap-5 lg:flex">
      <span class="mb-1 h-20 w-px bg-white/15"></span>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="text-white/40 transition-all duration-300 hover:-translate-y-0.5 hover:text-accent">
          <Icon name={s.name} size={18} />
        </a>
      ))}
      <span class="mt-1 h-20 w-px bg-white/15"></span>
    </div>

    <div class="grid min-h-screen items-stretch lg:grid-cols-[46fr_54fr]">
      <!-- LEFT -->
      <div class="relative z-10 flex flex-col justify-center px-6 pb-44 pt-36 sm:px-12 lg:pb-40 lg:pl-24 lg:pr-12">
        <p class="eyebrow leading-[2]" data-reveal>Interior Design Studio<br />Islamabad &amp; Rawalpindi</p>
        <h1 class="mt-6 font-display font-medium leading-[0.95] text-white" data-reveal style="--reveal-delay:.1s">
          <span class="block text-[clamp(2.9rem,6.2vw,6.25rem)]">Crafting</span>
          <span class="block text-[clamp(2.9rem,6.2vw,6.25rem)]">interiors,</span>
          <span class="mt-1 block text-[clamp(2.9rem,6.2vw,6.25rem)] italic text-accent">defining lifestyles.</span>
        </h1>
        <span class="accent-rule mt-8" data-reveal></span>
        <p class="mt-8 max-w-md text-white/65" data-reveal style="--reveal-delay:.2s">
          From concept and 3D visualisation to premium finishes and turnkey delivery, we craft calm, functional homes that mirror the people who live in them.
        </p>
        <div class="mt-9 flex flex-wrap gap-4" data-reveal style="--reveal-delay:.3s">
          <a href="/contact" class="btn btn-solid">Book a Free Consultation <Icon name="arrow" size={15} class="arrow" /></a>
          <a href="/projects" class="btn btn-ghost">View Projects <Icon name="arrow" size={15} class="arrow" /></a>
        </div>
      </div>

      <!-- RIGHT image -->
      <div class="relative min-h-[52vh] lg:min-h-screen">
        <img src={heroImage} alt="Luxury living room interior by Home Studio Interiors" class="absolute inset-0 h-full w-full object-cover" data-parallax="0.08" fetchpriority="high" />
        <div class="absolute inset-y-0 left-0 w-2/5 bg-gradient-to-r from-bone via-bone/60 to-transparent"></div>
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-bone/70 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-bone to-transparent"></div>
      </div>
    </div>

    <!-- feature strip -->
    <div class="absolute inset-x-0 bottom-0 z-20 border-t border-white/10 bg-bone/70 backdrop-blur-md">
      <div class="mx-auto grid max-w-[86rem] grid-cols-2 gap-x-6 gap-y-5 px-6 py-5 sm:px-12 lg:grid-cols-4 lg:pl-24">
        {heroFeatures.map((f) => (
          <div class="group flex items-center gap-3.5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-accent/30 text-accent transition-all duration-500 group-hover:border-accent group-hover:bg-accent/10">
              <Icon name={f.icon} size={20} />
            </span>
            <div>
              <p class="text-[0.8rem] font-semibold uppercase tracking-wide text-white">{f.title}</p>
              <p class="text-xs text-white/45">{f.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MARQUEE BAND -->
  <div class="marquee border-y border-line bg-sand py-6">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span class="flex items-center gap-9 pr-9">
          {['Kitchens', 'Wardrobes', 'Vanities', 'Media Walls', 'Doors', 'Turnkey Fit-outs', '3D Design'].map((w) => (
            <span class="flex items-center gap-9"><span class="font-display text-2xl italic text-white/85 md:text-3xl">{w}</span><span class="text-accent">&#10022;</span></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- 2 · WHY CHOOSE -->
  <section class="bg-sand py-28 md:py-36">
    <div class="container-page grid items-center gap-16 lg:grid-cols-2">
      <!-- LEFT: framed image + testimonial card -->
      <div class="relative">
        <div class="absolute -left-5 -top-5 z-0 hidden grid-cols-6 gap-2 lg:grid" aria-hidden="true">
          {Array.from({ length: 30 }).map(() => <span class="h-1 w-1 rounded-full bg-accent/40"></span>)}
        </div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-accent/30 p-2" data-reveal="img">
          <img src="/images/living-a.webp" alt="Home Studio Interiors design process" loading="lazy" class="h-[30rem] w-full rounded-[1.4rem] object-cover" />
        </div>
        <!-- testimonial card -->
        <div class="relative z-10 mx-4 -mt-20 rounded-2xl border border-accent/40 bg-gradient-to-br from-accent/30 via-accent/10 to-surface/95 p-7 backdrop-blur-md sm:mx-8 lg:absolute lg:bottom-5 lg:left-5 lg:-mt-0 lg:mx-0 lg:max-w-sm" data-reveal>
          <p class="font-display text-6xl leading-[0.4] text-accent">&ldquo;</p>
          <p class="mt-4 font-display text-xl italic leading-snug text-white">{founder.quote}</p>
          <div class="mt-6 flex items-center gap-3 border-t border-white/15 pt-5">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-accent/20 font-sans text-sm font-semibold text-accent">HN</span>
            <div>
              <p class="text-sm font-semibold text-white">{founder.name}</p>
              <p class="text-xs text-accent">{founder.role}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: content -->
      <div>
        <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">Modern Living</span></div>
        <h2 class="display-lg mt-5" data-reveal>Why Choose <span class="text-accent">Home Studio</span> Interiors?</h2>
        <span class="accent-rule mt-6 block" data-reveal></span>
        <p class="mt-6 max-w-xl text-muted" data-reveal>
          Choosing the right interior designer in Islamabad shapes how you live every day. With <span class="font-medium text-accent">8+ years</span>, <span class="font-medium text-accent">95%+</span> positive feedback and <span class="font-medium text-accent">2,488+</span> satisfied clients, we pair local know-how with modern detail and accountable project management.
        </p>
        <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2">
          {differentiators.map((d, i) => (
            <div class="group flex gap-4" data-reveal style={`--reveal-delay:${(i % 2) * 0.08}s`}>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-accent/40 text-accent transition-all duration-500 group-hover:bg-accent group-hover:text-white">
                <Icon name={d.icon} size={22} />
              </span>
              <div>
                <h3 class="font-sans text-base font-semibold text-white">{d.title}</h3>
                <p class="mt-1 text-sm text-muted">{d.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- stats bar -->
    <div class="container-page mt-16">
      <div class="grid grid-cols-1 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface/40 sm:grid-cols-3 sm:divide-x sm:divide-y-0" data-reveal>
        {statBar.map((s) => (
          <div class="spotlight group flex flex-col items-center px-6 py-12 text-center transition-colors hover:bg-surface/70">
            <Icon name={s.icon} size={28} class="text-accent transition-transform duration-500 group-hover:scale-110" />
            <p class="mt-4 font-display text-5xl text-white md:text-6xl" data-count={s.num} data-suffix={s.suffix}>{s.value}</p>
            <p class="mt-2 text-xs uppercase tracking-[0.22em] text-muted">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · WHAT WE DO (tabbed) -->
  <section class="container-page py-28 md:py-36" data-tabs>
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <div>
        <span class="inline-flex items-center gap-2.5 rounded-full border border-accent/50 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent" data-reveal><span class="h-2 w-2 rounded-full bg-accent"></span>What We Do</span>
        <h2 class="display-lg mt-6" data-reveal>We design spaces <span class="italic text-accent">that reflect you</span>.</h2>
      </div>
      <div class="lg:text-right" data-reveal>
        <p class="max-w-md text-muted lg:ml-auto">Recent transformations across kitchens, wardrobes, doors, vanities and media walls in Islamabad &amp; Rawalpindi — balanced for style, function and comfort.</p>
        <a href="/projects" class="btn btn-ghost mt-6">View All Projects <Icon name="arrow" size={15} class="arrow" /></a>
      </div>
    </div>

    <!-- tabs -->
    <div class="mt-12 flex flex-wrap gap-3 border-b border-line pb-12">
      {serviceTabs.map((t, i) => (
        <button type="button" data-tab={t.slug} class:list={["flex items-center gap-3 rounded-full border px-6 py-3.5 text-sm font-semibold uppercase tracking-wide transition-all duration-300", i === 0 ? "border-accent bg-accent text-white" : "border-line text-white/70 hover:border-accent/60 hover:text-white"]}>
          <Icon name={t.tabIcon} size={20} />{t.label}
        </button>
      ))}
    </div>

    <!-- panels -->
    {serviceTabs.map((t, i) => (
      <div data-panel={t.slug} class:list={["mt-12 grid items-center gap-12 lg:grid-cols-2", i === 0 ? "" : "hidden"]}>
        <div>
          <div class="flex items-center gap-3"><span class="accent-rule"></span><span class="eyebrow">{t.eyebrow}</span></div>
          <h3 class="mt-5 font-display text-[clamp(1.9rem,3.4vw,3rem)] font-medium leading-tight text-white">{t.headA}<span class="italic text-accent">{t.headItalic}</span>{t.headB}</h3>
          <p class="mt-5 max-w-md text-muted">{t.text}</p>
          <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4">
            {t.features.map((f) => (
              <div class="flex flex-col gap-2.5">
                <span class="grid h-11 w-11 place-items-center rounded-full border border-accent/40 text-accent"><Icon name={f.i} size={20} /></span>
                <p class="text-xs leading-snug text-white/70">{f.t}</p>
              </div>
            ))}
          </div>
          <a href={`/services/${t.slug}`} class="btn btn-solid mt-8">View Detail <Icon name="arrow" size={15} class="arrow" /></a>
          <div class="mt-8 grid grid-cols-2 gap-4">
            {t.cards.map((c) => (
              <a href={`/services/${t.slug}`} class="spotlight group relative block overflow-hidden rounded-xl border border-line transition-colors hover:border-accent/50">
                <img src={c.image} alt={c.label} loading="lazy" class="h-36 w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 flex items-end justify-between bg-gradient-to-t from-graphite/90 to-transparent p-4">
                  <span class="text-sm font-semibold text-white">{c.label}</span>
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-accent text-white transition-transform group-hover:translate-x-0.5"><Icon name="arrow" size={13} /></span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-line">
          <img src={t.image} alt={t.label} loading="lazy" class="h-[30rem] w-full object-cover lg:h-[38rem]" />
          <button type="button" class="group absolute inset-0 grid place-items-center" aria-label="Play showreel">
            <span class="grid h-20 w-20 place-items-center rounded-full border border-white/60 bg-black/25 text-white backdrop-blur transition-all duration-300 group-hover:scale-110 group-hover:border-accent group-hover:text-accent">
              <Icon name="play" size={32} />
            </span>
          </button>
        </div>
      </div>
    ))}
  </section>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-tabs]'); if (!root) return;
      var tabs = root.querySelectorAll('[data-tab]');
      var panels = root.querySelectorAll('[data-panel]');
      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slug = btn.getAttribute('data-tab');
          tabs.forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('border-accent', on); b.classList.toggle('bg-accent', on); b.classList.toggle('text-white', on);
            b.classList.toggle('border-line', !on); b.classList.toggle('text-white/70', !on);
          });
          panels.forEach(function (p) { p.classList.toggle('hidden', p.getAttribute('data-panel') !== slug); });
        });
      });
    })();
  </script>

  <!-- 5 · WHAT WE DELIVER -->
  <section class="container-page py-28 md:py-36">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">What We Deliver</span></div>
        <h2 class="display-lg mt-5" data-reveal>Transforming ideas into timeless living spaces.</h2>
        <p class="mt-6 max-w-md text-muted" data-reveal>From kitchens and wardrobes to doors, vanities and media walls, we design and build spaces that last. One team manages design, materials and turnkey installation across Islamabad &amp; Rawalpindi.</p>
      </div>
      <div class="lg:col-span-7">
        <div class="divide-y divide-line border-y border-line">
          {deliverables.map((d) => (
            <div class="spotlight group flex items-center gap-6 rounded-xl px-4 py-6 transition-colors hover:bg-surface/40" data-reveal>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-accent/40 text-accent transition-all duration-500 group-hover:bg-accent group-hover:text-white"><Icon name={d.icon} size={22} /></span>
              <div>
                <h3 class="font-sans text-lg font-semibold text-white">{d.title}</h3>
                <p class="mt-1 text-sm text-muted">{d.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 6 · PROCESS -->
  <section class="bg-sand py-28 md:py-36">
    <div class="container-page">
      <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">How We Work</span></div>
      <h2 class="display-lg mt-5 max-w-3xl" data-reveal>Our interior design process.</h2>
      <div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, i) => (
          <div class="group relative border-t-2 border-line pt-6 transition-colors hover:border-accent" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <p class="font-display text-6xl text-accent">{step.no}</p>
            <h3 class="mt-4 font-display text-2xl">{step.title}</h3>
            <p class="mt-3 text-sm text-muted">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CINEMATIC BAND -->
  <section class="relative flex h-[62vh] min-h-[26rem] items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src={bandImage} alt="Luxury interior by Home Studio Interiors" class="h-full w-full scale-110 object-cover" data-parallax="0.14" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-r from-bone via-bone/55 to-bone/10"></div>
      <div class="absolute inset-0 bg-graphite/25"></div>
    </div>
    <div class="container-page relative z-10">
      <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">The Home Studio Difference</span></div>
      <h2 class="display-lg mt-5 max-w-2xl text-white" data-reveal>Interiors designed to be <span class="italic text-accent">lived in</span>.</h2>
      <p class="mt-6 max-w-md text-white/75" data-reveal>Warm materials, considered light and craftsmanship you feel every single day.</p>
      <a href="/projects" class="btn btn-solid mt-8 w-fit" data-reveal>Explore Our Work <Icon name="arrow" size={15} class="arrow" /></a>
    </div>
  </section>

  <!-- 7 · WHO WE ARE -->
  <section class="container-page py-28 md:py-36">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div class="overflow-hidden rounded-2xl border border-line p-2" data-reveal="img">
        <img src={aboutImage} alt="Home Studio Interiors" loading="lazy" class="h-[30rem] w-full rounded-xl object-cover" />
      </div>
      <div>
        <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">Who We Are</span></div>
        <h2 class="display-lg mt-5" data-reveal>Designing spaces that define you.</h2>
        <p class="mt-6 max-w-xl text-muted" data-reveal>At Home Studio Interiors, a residential interior design studio in Islamabad, we blend smart planning with warm materials to create homes that feel effortless — designed for daily life, built to last.</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2" data-reveal>
          {differentiators.map((d) => (
            <div class="flex items-start gap-3">
              <span class="mt-1 text-accent"><Icon name={d.icon} size={18} /></span>
              <div><h3 class="text-sm font-semibold text-white">{d.title}</h3><p class="text-sm text-muted">{d.text}</p></div>
            </div>
          ))}
        </div>
        <a href="/about" class="link-underline mt-9 inline-block text-sm uppercase tracking-[0.16em] text-accent" data-reveal>More about the studio →</a>
      </div>
    </div>
  </section>

  <!-- 8 · CTA -->
  <CtaBand title="Ready to transform your space?" />

  <!-- 9 · TESTIMONIALS -->
  <section class="bg-sand py-28 md:py-36">
    <div class="container-page">
      <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">Client Stories</span></div>
      <h2 class="display-lg mt-5 max-w-2xl" data-reveal>What our clients say about us.</h2>
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        {testimonials.map((t) => (
          <blockquote class="border-t border-line pt-8" data-reveal>
            <p class="font-display text-2xl leading-snug text-ink">“{t.quote}”</p>
            <footer class="mt-6 text-sm uppercase tracking-[0.14em] text-muted">{t.name} · <span class="text-accent">{t.place}</span></footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page py-28 md:py-36">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow" data-reveal>Good to know</p>
        <h2 class="display-lg mt-4" data-reveal>Frequently asked questions.</h2>
      </div>
      <div class="lg:col-span-8">
        {faqs.map((f) => (
          <details class="group border-b border-line py-6" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
              <span class="font-display text-xl text-ink md:text-2xl">{f.q}</span>
              <span class="text-2xl text-accent transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 max-w-2xl text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 11 · FINAL CTA -->
  <CtaBand title="From idea to reality — let's begin." text="Book a free consultation with an interior designer in Islamabad. Concept → 3D → turnkey handover, on time and on budget." />
</Base>
