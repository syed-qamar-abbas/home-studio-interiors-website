  <script is:inline>
    (function () {
      var root = document.querySelector('[data-deliver]'); if (!root) return;
      var tabs = root.querySelectorAll('[data-deliver-tab]');
      var panels = root.querySelectorAll('[data-deliver-panel]');
      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slug = btn.getAttribute('data-deliver-tab');
          tabs.forEach(function (tab) {
            var on = tab === btn;
            tab.setAttribute('aria-pressed', on ? 'true' : 'false');
            tab.classList.toggle('border-accent', on);
            tab.classList.toggle('bg-accent', on);
            tab.classList.toggle('text-white', on);
            tab.classList.toggle('shadow-[0_20px_40px_-22px_rgba(242,112,37,0.9)]', on);
            tab.classList.toggle('border-white/10', !on);
            tab.classList.toggle('bg-white/[0.06]', !on);
            tab.classList.toggle('text-white/68', !on);
          });
          panels.forEach(function (panel) {
            var on = panel.getAttribute('data-deliver-panel') === slug;
            panel.classList.toggle('hidden', !on);
            panel.classList.toggle('is-active', on);
          });
        });
      });
    })();
  </script>

