---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, serviceTabs, processSteps, differentiators, deliverables, signatureCollections, materialHighlights, projectPortfolio, testimonials, faqs, heroImage, aboutImage, bandImage, heroFeatures, founder } from '../data/site';
const socials = [
  { name: 'instagram', href: site.socials.instagram },
  { name: 'facebook', href: site.socials.facebook },
  { name: 'pinterest', href: 'https://pinterest.com/' },
  { name: 'linkedin', href: site.socials.linkedin },
];
const statBar = [
  { num: 8, suffix: '+', value: '8+', label: 'Years of Experience', icon: 'award' },
  { num: 95, suffix: '+', value: '95+', label: 'Positive Feedback', icon: 'thumb' },
  { num: 2488, suffix: '+', value: '2,488+', label: 'Satisfied Clients', icon: 'users' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  image: heroImage,
  url: site.url,
  telephone: site.phoneIntl,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Islamabad', addressRegion: 'ICT', addressCountry: 'PK' },
  areaServed: site.areaServed,
  priceRange: '$$',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: site.rating.value, reviewCount: site.rating.count },
};
---
<Base jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative min-h-[86svh] overflow-hidden bg-graphite md:min-h-screen" data-cursor-glow>
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt="" class="absolute inset-0 h-full w-full object-cover object-center opacity-92 md:hidden" fetchpriority="high" decoding="async" />
      <div class="absolute inset-0 hidden md:block">
        <img src={heroImage} alt="" class="h-full w-full scale-[1.04] object-cover object-center opacity-35 blur-sm" aria-hidden="true" />
        <img src={heroImage} alt="Luxury orange-accent interior by Home Studio Interiors" class="absolute inset-0 h-full w-full object-contain object-center opacity-95" data-parallax="0.025" data-parallax-scale="1" fetchpriority="high" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-r from-graphite via-graphite/70 to-graphite/18"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-graphite via-transparent to-graphite/35"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_68%_44%,rgba(242,112,37,.18),transparent_27%)]"></div>
        <div class="absolute inset-y-0 right-0 hidden w-1/3 bg-gradient-to-l from-graphite/40 to-transparent lg:block"></div>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-graphite via-transparent to-graphite/45 md:hidden"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-graphite/30 via-transparent to-graphite/65 md:hidden"></div>
    </div>
    <div class="pointer-events-none absolute inset-0 z-0 hidden lg:block" style="background: radial-gradient(28rem 28rem at var(--gx, 25%) var(--gy, 35%), rgba(242,112,37,0.12), transparent 62%);"></div>
    <!-- vertical socials -->
    <div class="absolute left-0 top-0 z-30 hidden h-full w-14 flex-col items-center justify-center gap-5 lg:flex">
      <span class="mb-1 h-20 w-px bg-white/15"></span>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="text-white/40 transition-all duration-300 hover:-translate-y-0.5 hover:text-accent">
          <Icon name={s.name} size={18} />
        </a>
      ))}
      <span class="mt-1 h-20 w-px bg-white/15"></span>
    </div>

    <div class="container-page relative z-10 grid min-h-[78svh] items-center gap-10 pb-10 pt-28 md:min-h-screen md:pb-44 md:pt-32 lg:grid-cols-[minmax(0,1fr)_24rem] lg:pb-40">
      <div class="max-w-3xl">
        <p class="eyebrow leading-[2]" data-reveal>Interior Design Studio<br />Islamabad &amp; Rawalpindi</p>
        <h1 class="hero-title mt-5 leading-[1.02] text-white md:mt-6" data-reveal style="--reveal-delay:.1s">
          <span class="hero-line block text-[clamp(2.05rem,9.8vw,4.85rem)] md:text-[clamp(2.25rem,4.55vw,4.85rem)]">Crafting</span>
          <span class="hero-line block text-[clamp(2.05rem,9.8vw,4.85rem)] md:text-[clamp(2.25rem,4.55vw,4.85rem)]">interiors,</span>
          <span class="hero-line mt-1 block text-[clamp(2.05rem,9.8vw,4.85rem)] italic text-accent md:text-[clamp(2.25rem,4.55vw,4.85rem)]">defining lifestyles.</span>
        </h1>
        <span class="accent-rule mt-6 md:mt-8" data-reveal></span>
        <p class="mt-6 max-w-xl text-sm leading-7 text-white/72 md:mt-8 md:text-base md:leading-8" data-reveal style="--reveal-delay:.2s">
          From concept and 3D visualisation to premium finishes and turnkey delivery, we craft calm, functional homes that mirror the people who live in them.
        </p>
        <div class="mt-7 flex flex-wrap gap-3 md:mt-9 md:gap-4" data-reveal style="--reveal-delay:.3s">
          <a href="/contact" data-open-quote class="btn btn-solid">Get a Quote <Icon name="arrow" size={15} class="arrow" /></a>
          <a href="#what-we-do" class="btn btn-ghost">Explore Services <Icon name="arrow" size={15} class="arrow" /></a>
        </div>
        <div class="mt-12 hidden max-w-2xl grid-cols-3 gap-3 lg:grid" data-reveal style="--reveal-delay:.38s">
          {deliverables.slice(0, 3).map((d) => (
            <a href={`/services/${d.slug}`} class="group overflow-hidden rounded-2xl border border-white/12 bg-white/[0.05] p-2 backdrop-blur-md transition-all duration-500 hover:border-accent/60 hover:bg-white/[0.08]">
              <img src={d.images[0]} alt={`${d.title} interior design`} loading="lazy" class="h-24 w-full rounded-xl object-cover opacity-85 transition duration-700 group-hover:scale-105 group-hover:opacity-100" />
              <span class="mt-3 flex items-center justify-between px-1 pb-1 text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-white/72">
                {d.title}
                <Icon name="arrow" size={12} class="text-accent transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          ))}
        </div>
      </div>
      <aside class="hero-float-card hidden self-end rounded-[1.6rem] border border-white/12 bg-black/25 p-5 backdrop-blur-xl lg:block" data-reveal="right" style="--reveal-delay:.45s">
        <div class="flex items-center justify-between border-b border-white/10 pb-4">
          <span class="section-kicker">Studio scope</span>
          <span class="h-2.5 w-2.5 rounded-full bg-accent shadow-[0_0_24px_rgba(242,112,37,.9)]"></span>
        </div>
        <div class="mt-5 space-y-3">
          {deliverables.map((d, i) => (
            <a href={`/services/${d.slug}`} class="group flex items-center gap-3 rounded-2xl border border-white/8 bg-white/[0.045] p-2 transition-all duration-500 hover:border-accent/50 hover:bg-accent/10">
              <img src={d.images[0]} alt="" loading="lazy" class="h-14 w-16 rounded-xl object-cover opacity-75 transition duration-500 group-hover:opacity-100" />
              <span class="min-w-0 flex-1">
                <span class="number-mark block">{String(i + 1).padStart(2, '0')}</span>
                <span class="block truncate text-sm font-semibold uppercase tracking-[0.16em] text-white/82">{d.title}</span>
              </span>
              <Icon name="arrow" size={13} class="text-accent transition-transform group-hover:translate-x-1" />
            </a>
          ))}
        </div>
      </aside>
    </div>

    <a href="#what-we-do" class="absolute bottom-32 right-6 z-30 hidden items-center gap-3 text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-white/45 transition-colors hover:text-accent lg:flex">
      <span class="relative h-12 w-px overflow-hidden bg-white/15"><span class="scroll-pulse absolute left-0 top-0 h-5 w-px bg-accent"></span></span>
      Scroll to explore
    </a>

    <!-- feature strip -->
    <div class="absolute inset-x-0 bottom-0 z-20 hidden border-t border-white/10 bg-bone/70 backdrop-blur-md md:block">
      <div class="mx-auto grid max-w-[86rem] grid-cols-2 gap-x-6 gap-y-5 px-6 py-5 sm:px-12 lg:grid-cols-4 lg:pl-24">
        {heroFeatures.map((f) => (
          <div class="group flex items-center gap-3.5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-accent/30 text-accent transition-all duration-500 group-hover:border-accent group-hover:bg-accent/10">
              <Icon name={f.icon} size={20} />
            </span>
            <div>
              <p class="text-[0.8rem] font-semibold uppercase tracking-wide text-white">{f.title}</p>
              <p class="text-xs text-white/45">{f.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MARQUEE BAND -->
  <div class="marquee border-y border-line bg-sand py-6">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <span class="flex items-center gap-9 pr-9">
          {['Kitchens', 'Wardrobes', 'Vanities', 'Media Walls', 'Doors', 'Turnkey Fit-outs', '3D Design'].map((w) => (
            <span class="flex items-center gap-9"><span class="font-display text-2xl italic text-white/85 md:text-3xl">{w}</span><span class="text-accent">&#10022;</span></span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- 2 · WHY CHOOSE -->
  <section class="bg-sand py-12 md:py-36">
    <div class="container-page grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <!-- LEFT: framed image + testimonial card -->
      <div class="relative hidden md:block">
        <div class="absolute -left-5 -top-5 z-0 hidden grid-cols-6 gap-2 lg:grid" aria-hidden="true">
          {Array.from({ length: 30 }).map(() => <span class="h-1 w-1 rounded-full bg-accent/40"></span>)}
        </div>
        <div class="relative overflow-hidden rounded-[1.75rem] border border-accent/30 p-2" data-reveal="img">
          <img src="/images/home/design-sketch-founder.webp" alt="Interior designer visualising a Home Studio Interiors concept sketch" loading="lazy" decoding="async" class="h-[30rem] w-full rounded-[1.4rem] object-cover object-center" />
          <div class="pointer-events-none absolute inset-2 rounded-[1.4rem] bg-gradient-to-t from-graphite/35 via-transparent to-transparent"></div>
        </div>
        <!-- testimonial card -->
        <div class="relative z-10 mx-8 -mt-14 rounded-2xl border border-accent/35 bg-graphite/58 p-5 shadow-[0_24px_70px_-36px_rgba(0,0,0,.95)] backdrop-blur-xl lg:absolute lg:bottom-6 lg:right-6 lg:-mt-0 lg:mx-0 lg:max-w-[20rem]" data-reveal>
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-white/[0.08] via-transparent to-accent/[0.08]"></div>
          <div class="relative">
          <p class="font-display text-4xl leading-[0.4] text-accent">&ldquo;</p>
          <p class="mt-3 font-display text-lg italic leading-snug text-white/92">{founder.quote}</p>
          <div class="mt-5 flex items-center gap-3 border-t border-white/12 pt-4">
            <span class="grid h-10 w-10 place-items-center rounded-full bg-accent/18 font-sans text-xs font-semibold text-accent ring-1 ring-accent/25">HN</span>
            <div>
              <p class="text-sm font-semibold text-white">{founder.name}</p>
              <p class="text-xs text-accent">{founder.role}</p>
            </div>
          </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: content -->
      <div>
        <div class="flex items-center gap-3" data-reveal><span class="accent-rule"></span><span class="eyebrow">Modern Living</span></div>
        <h2 class="display-lg mt-5" data-reveal>Why Choose <span class="text-accent">Home Studio</span> Interiors?</h2>
        <span class="accent-rule mt-6 block" data-reveal></span>
        <p class="mt-6 max-w-xl text-muted" data-reveal>
          Choosing the right interior designer in Islamabad shapes how you live every day. With <span class="font-medium text-accent">8+ years</span>, <span class="font-medium text-accent">95%+</span> positive feedback and <span class="font-medium text-accent">2,488+</span> satisfied clients, we pair local know-how with modern detail and accountable project management.
        </p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2 md:mt-10 md:gap-x-8 md:gap-y-8">
          {differentiators.map((d, i) => (
            <div class="group flex gap-3 rounded-2xl border border-line bg-white/[0.025] p-4 md:border-0 md:bg-transparent md:p-0" data-reveal style={`--reveal-delay:${(i % 2) * 0.08}s`}>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-accent/40 text-accent transition-all duration-500 group-hover:bg-accent group-hover:text-white md:h-12 md:w-12">
                <Icon name={d.icon} size={22} />
              </span>
              <div>
                <h3 class="font-sans text-base font-semibold text-white">{d.title}</h3>
                <p class="mt-1 text-sm text-muted">{d.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- stats bar -->
    <div class="container-page mt-10 md:mt-16">
      <div class="grid grid-cols-3 divide-x divide-line overflow-hidden rounded-2xl border border-line bg-surface/40 md:rounded-3xl" data-reveal>
        {statBar.map((s) => (
          <div class="spotlight group flex flex-col items-center px-2 py-4 text-center transition-colors hover:bg-surface/70 md:px-6 md:py-12">
            <Icon name={s.icon} size={20} class="text-accent transition-transform duration-500 group-hover:scale-110 md:size-7" />
            <p class="mt-2 font-display text-2xl text-white md:mt-4 md:text-6xl" data-count={s.num} data-suffix={s.suffix}>{s.value}</p>
            <p class="mt-1 text-[0.58rem] uppercase leading-snug tracking-[0.12em] text-muted md:mt-2 md:text-xs md:tracking-[0.22em]">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · WHAT WE DO (tabbed) -->
  <section id="what-we-do" class="container-page py-12 md:py-32" data-tabs>
    <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
      <div>
        <span class="inline-flex items-center gap-2.5 rounded-full border border-accent/50 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent" data-reveal><span class="h-2 w-2 rounded-full bg-accent"></span>What We Do</span>
        <h2 class="display-lg mt-6" data-reveal>We design spaces <span class="italic text-accent">that reflect you</span>.</h2>
      </div>
      <div class="lg:text-right" data-reveal>
        <p class="max-w-md text-muted lg:ml-auto">Recent transformations across kitchens, wardrobes, doors, vanities and media walls in Islamabad &amp; Rawalpindi — balanced for style, function and comfort.</p>
        <a href="/projects" class="btn btn-ghost mt-6">View All Projects <Icon name="arrow" size={15} class="arrow" /></a>
      </div>
    </div>

    <!-- mobile service cards: direct browsing, no tab jump -->
    <div class="mt-8 grid gap-4 lg:hidden">
      {serviceTabs.map((t) => (
        <a href={`/services/${t.slug}`} class="group grid grid-cols-[7.5rem_1fr] overflow-hidden rounded-[1.35rem] border border-line bg-surface/55" data-reveal>
          <img src={t.image} alt={t.label} loading="lazy" class="h-full min-h-36 w-full object-cover" />
          <div class="p-4">
            <p class="number-mark">{t.eyebrow}</p>
            <h3 class="mt-2 font-display text-2xl text-white">{t.label}</h3>
            <p class="mt-2 line-clamp-2 text-xs leading-6 text-muted">{t.text}</p>
            <span class="mt-3 inline-flex items-center gap-2 text-[0.66rem] font-semibold uppercase tracking-[0.14em] text-accent">Explore <Icon name="arrow" size={12} /></span>
          </div>
        </a>
      ))}
    </div>

    <!-- tabs -->
    <div class="mt-12 hidden flex-wrap gap-3 border-b border-line pb-12 lg:flex">
      {serviceTabs.map((t, i) => (
        <button type="button" data-tab={t.slug} class:list={["flex items-center gap-3 rounded-full border px-6 py-3.5 text-sm font-semibold uppercase tracking-wide transition-all duration-300", i === 0 ? "border-accent bg-accent text-white" : "border-line text-white/70 hover:border-accent/60 hover:text-white"]}>
          <Icon name={t.tabIcon} size={20} />{t.label}
        </button>
      ))}
    </div>

    <!-- panels -->
    {serviceTabs.map((t, i) => (
      <div data-panel={t.slug} class:list={["mt-12 max-lg:hidden lg:grid-cols-2 lg:items-center lg:gap-12", i === 0 ? "lg:grid" : "hidden"]}>
        <div>
          <div class="flex items-center gap-3"><span class="accent-rule"></span><span class="eyebrow">{t.eyebrow}</span></div>
          <h3 class="mt-5 max-w-2xl break-words font-display text-[clamp(1.7rem,3.2vw,2.85rem)] font-medium leading-[1.16] text-white">{t.headA}<span class="italic text-accent">{t.headItalic}</span>{t.headB}</h3>
          <p class="mt-5 max-w-md text-muted">{t.text}</p>
          <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4">
            {t.features.map((f) => (
              <div class="flex flex-col gap-2.5">
                <span class="grid h-11 w-11 place-items-center rounded-full border border-accent/40 text-accent"><Icon name={f.i} size={20} /></span>
                <p class="text-xs leading-snug text-white/70">{f.t}</p>
              </div>
            ))}
          </div>
          <a href={`/services/${t.slug}`} class="btn btn-solid mt-8">View Detail <Icon name="arrow" size={15} class="arrow" /></a>
          <div class="mt-8 grid grid-cols-2 gap-4">
            {t.cards.map((c) => (
              <a href={`/services/${t.slug}`} class="spotlight group relative block overflow-hidden rounded-xl border border-line transition-colors hover:border-accent/50">
                <img src={c.image} alt={c.label} loading="lazy" class="h-36 w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <div class="absolute inset-0 flex items-end justify-between bg-gradient-to-t from-graphite/90 to-transparent p-4">
                  <span class="text-sm font-semibold text-white">{c.label}</span>
                  <span class="grid h-7 w-7 place-items-center rounded-full bg-accent text-white transition-transform group-hover:translate-x-0.5"><Icon name="arrow" size={13} /></span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-line">
          <img src={t.image} alt={t.label} loading="lazy" class="h-[30rem] w-full object-cover lg:h-[38rem]" />
          <button type="button" class="group absolute inset-0 grid place-items-center" aria-label="Play showreel">
            <span class="grid h-20 w-20 place-items-center rounded-full border border-white/60 bg-black/25 text-white backdrop-blur transition-all duration-300 group-hover:scale-110 group-hover:border-accent group-hover:text-accent">
              <Icon name="play" size={32} />
            </span>
          </button>
        </div>
      </div>
    ))}
  </section>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-tabs]'); if (!root) return;
      var tabs = root.querySelectorAll('[data-tab]');
      var panels = root.querySelectorAll('[data-panel]');
      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var slug = btn.getAttribute('data-tab');
          tabs.forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('border-accent', on); b.classList.toggle('bg-accent', on); b.classList.toggle('text-white', on);
            b.classList.toggle('border-line', !on); b.classList.toggle('text-white/70', !on);
          });
          panels.forEach(function (p) {
            var active = p.getAttribute('data-panel') === slug;
            p.classList.toggle('hidden', !active);
            p.classList.toggle('lg:grid', active);
          });
        });
      });
    })();
  </script>

  <!-- 5 · WHAT WE DELIVER -->
  <section class="relative hidden overflow-hidden bg-graphite py-24 lg:block lg:py-32" data-deliver>
    <div class="absolute inset-0 opacity-[0.08] page-grid-line"></div>
    <div class="container-page relative">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-4">
          <div class="inline-flex items-center gap-3 rounded-full border border-accent px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-white" data-reveal>
            <span class="h-3 w-3 rounded-full bg-accent"></span> What We Deliver
          </div>
        </div>
        <div class="lg:col-span-8">
          <h2 class="display-lg max-w-5xl text-white" data-reveal>
            Transforming <span class="italic text-accent">ideas into timeless living</span> spaces.
          </h2>
          <p class="mt-6 max-w-3xl text-base leading-8 text-white/68" data-reveal>
            From kitchens and wardrobes to doors, vanities and media walls, we design and build spaces that last. One team manages design, materials and turnkey installation across Islamabad &amp; Rawalpindi.
          </p>
        </div>
      </div>

      <div class="mt-14 flex gap-3 overflow-x-auto pb-3 md:flex-wrap md:justify-center md:overflow-visible" data-reveal>
        {deliverables.map((d, i) => (
          <button
            type="button"
            class={`deliver-tab shrink-0 rounded-full border px-6 py-3.5 text-xs font-bold uppercase tracking-[0.2em] transition-all duration-500 md:min-w-[10rem] md:px-7 md:py-4 ${i === 0 ? 'border-accent bg-accent text-white shadow-[0_20px_40px_-22px_rgba(242,112,37,0.9)]' : 'border-white/10 bg-white/[0.06] text-white/68 hover:border-accent/60 hover:text-white'}`}
            data-deliver-tab={d.slug}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {d.title}
          </button>
        ))}
      </div>

      <div class="relative mt-12 min-h-[44rem]">
        {deliverables.map((d, i) => (
          <div class={`deliver-panel ${i === 0 ? 'is-active' : 'hidden'}`} data-deliver-panel={d.slug}>
            <div class="grid gap-6 lg:grid-cols-12 lg:items-stretch">
              <a href={`/services/${d.slug}`} class="spotlight group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.035] p-3 lg:col-span-7" data-reveal="img">
                <img src={d.images[0]} alt={`${d.title} delivered by Home Studio Interiors`} loading="lazy" class="h-[24rem] w-full rounded-[1.55rem] object-cover transition duration-[1.2s] group-hover:scale-[1.035] md:h-[34rem]" />
                <div class="absolute inset-3 rounded-[1.55rem] bg-gradient-to-t from-graphite/92 via-graphite/18 to-transparent"></div>
                <div class="absolute inset-x-8 bottom-8 flex items-end justify-between gap-6">
                  <div>
                    <span class="number-mark">Selected {String(i + 1).padStart(2, '0')}</span>
