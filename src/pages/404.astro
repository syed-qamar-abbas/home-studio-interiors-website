---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found — Home Studio Interiors">
  <section class="flex min-h-screen items-center bg-graphite text-white">
    <div class="container-page text-center">
      <p class="font-display text-[8rem] leading-none text-accent md:text-[12rem]">404</p>
      <h1 class="display-md mt-4 text-white">This room doesn't exist.</h1>
      <p class="mx-auto mt-6 max-w-md text-white/70">The page you're looking for may have moved. Let's get you back to something beautiful.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-solid">Back to Home</a>
        <a href="/projects" class="btn btn-ghost text-white">View Projects</a>
      </div>
    </div>
  </section>
</Base>
