---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Privacy Policy — Home Studio Interiors" description="How Home Studio Interiors collects, uses and protects your information.">
  <section class="container-page pt-40 pb-28 md:pt-48 md:pb-36">
    <p class="eyebrow">Legal</p>
    <h1 class="display-lg mt-4">Privacy Policy</h1>
    <div class="prose-lux mt-12 max-w-2xl space-y-6 text-muted">
      <p>Home Studio Interiors ("we", "us") respects your privacy. This policy explains what information we collect and how we use it when you visit {site.url} or enquire about our services.</p>
      <h2 class="font-display text-2xl text-ink">Information we collect</h2>
      <p>When you submit an enquiry we collect the details you provide — such as your name, phone number, email and project information — solely to respond to your request and manage your project.</p>
      <h2 class="font-display text-2xl text-ink">How we use it</h2>
      <p>We use your information to contact you, prepare proposals, and deliver our services. We do not sell your personal information to third parties.</p>
      <h2 class="font-display text-2xl text-ink">Data retention</h2>
      <p>We retain enquiry and project records only as long as necessary to serve you and meet legal obligations.</p>
      <h2 class="font-display text-2xl text-ink">Contact</h2>
      <p>For any privacy questions, email <a href={`mailto:${site.email}`} class="link-underline text-accent">{site.email}</a>.</p>
      <p class="text-sm">This is a general template — please review with your legal advisor before publishing.</p>
    </div>
  </section>
</Base>
