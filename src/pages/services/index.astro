---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services, heroImage, designPackages } from '../../data/site';
import { seoLandingPages } from '../../data/seo';

const priorityLocalPages = seoLandingPages.filter((page) => [
  'interior-designers-islamabad',
  'interior-designers-rawalpindi',
  'kitchen-design-islamabad',
  'kitchen-design-rawalpindi',
  'modular-kitchen-islamabad',
  'wardrobe-design-islamabad',
  'media-wall-design-islamabad',
  'bathroom-vanities-islamabad',
  'doors-design-islamabad',
  'home-remodeling-islamabad',
].includes(page.slug));
---
<Base title="Interior Design Services — Kitchens, Wardrobes, Vanities, Media Walls & Doors | Home Studio Interiors"
  description="Full-spectrum interior design and fit-out services in Islamabad & Rawalpindi — kitchens, wardrobes, vanities, media walls and doors, from 3D design to turnkey installation.">
  <PageHero eyebrow="What we do" title="Full-spectrum interior craft."
    subtitle="From kitchens and wardrobes to doors, vanities and media walls — we design and build spaces that last. One team manages design, materials and turnkey installation."
    image={heroImage} />

  <section class="container-page py-20 md:py-28">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}`} class="signature-card group overflow-hidden rounded-[1.6rem] border border-line bg-surface/55" data-reveal>
          <div class="card-hover image-frame border-0">
            <img src={s.image} alt={`${s.title} — ${s.tagline}`} loading="lazy" class="aspect-[4/5] w-full object-cover" />
            <div class="card-hover-label pointer-events-none absolute inset-0 flex items-end justify-between p-4">
              <span class="font-display text-2xl text-white">{s.title}</span>
              <span class="grid h-9 w-9 place-items-center rounded-full bg-accent text-white"><Icon name="arrow" size={14} /></span>
            </div>
          </div>
          <div class="p-5">
            <p class="number-mark">{String(i + 1).padStart(2, '0')} · Service</p>
            <h2 class="mt-3 font-display text-3xl">{s.title}</h2>
            <p class="mt-2 text-sm italic text-accent">{s.tagline}</p>
            <p class="mt-4 text-sm leading-7 text-muted">{s.excerpt}</p>
            <ul class="mt-5 space-y-2">
              {s.features.map((f) => (
                <li class="flex items-center gap-3 text-sm text-muted"><span class="h-px w-5 bg-accent"></span>{f}</li>
              ))}
            </ul>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-sand py-20 md:py-28">
    <div class="container-page">
      <p class="section-kicker" data-reveal>Ways to begin</p>
      <h2 class="display-md mt-4" data-reveal>Choose the level of support your home needs.</h2>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {designPackages.map((p) => (
          <div class="lux-card rounded-[1.4rem] p-6" data-reveal>
            <h3 class="font-display text-2xl">{p.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-20 md:py-28">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="section-kicker" data-reveal>Local service pages</p>
        <h2 class="display-md mt-4" data-reveal>Find the right interior service in Islamabad & Rawalpindi.</h2>
        <p class="mt-5 text-sm leading-7 text-muted" data-reveal>
          Dedicated pages for high-intent searches help homeowners compare services, budgets and next steps before contacting us on WhatsApp.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:col-span-8">
        {priorityLocalPages.map((page) => (
          <a href={`/${page.slug}`} class="group rounded-[1.15rem] border border-line bg-surface/45 p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50" data-reveal>
            <p class="number-mark">{page.city}</p>
            <h3 class="mt-2 font-display text-2xl leading-tight text-ink">{page.serviceName}</h3>
            <p class="mt-3 line-clamp-2 text-sm leading-7 text-muted">{page.description}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-accent">Open page <Icon name="arrow" size={13} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
