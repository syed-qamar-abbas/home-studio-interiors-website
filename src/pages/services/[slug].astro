---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services, serviceDetail, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const detail = serviceDetail[service.slug];
const others = services.filter((s) => s.slug !== service.slug);
const pageHeroImage = service.slug === 'kitchen' ? '/images/hero/orange-stair-lounge.webp' : service.image;
const serviceSingular: Record<string, string> = {
  kitchen: 'kitchen',
  wardrobe: 'wardrobe',
  vanities: 'vanity',
  'media-walls': 'media wall',
  doors: 'door',
};
const serviceStyleLabel = serviceSingular[service.slug] ?? service.title.toLowerCase();
const collectionNames: Record<string, string[]> = {
  kitchen: ['Seoul', 'Refined Contemporary', 'Oslo', 'Lira', 'Elara', 'Neom', 'Eris', 'Contrast', 'Elva', 'Miami', 'Modern Classic', 'Bold Classic', 'Navy Transitional', 'Oak Mediterranean', 'Farmhouse White', 'Sage Cottage'],
  wardrobe: ['Luxe', 'Aspen', 'Vienna', 'Urban Oak', 'Savoy', 'Paris'],
  vanities: ['Regal', 'Willow', 'Ambrosia', 'Pearl', 'Maple', 'Celine', 'Prague', 'Lisbon'],
  'media-walls': ['Opus', 'Mist', 'Majesty', 'Sierra', 'Pulse', 'Vivid', 'Elite', 'Elysian'],
  doors: ['Oakcrest', 'Palazzo', 'Forestgate', 'Ironbark', 'Opaloak', 'Tuscany', 'Bristol', 'Snowfall'],
};
const collection = collectionNames[service.slug] ?? [];
const hasCollections = Boolean(detail.collections?.length);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.title} Design & Installation`,
  serviceType: `${service.title} interior design`,
  provider: { '@type': 'LocalBusiness', name: site.name, telephone: site.phoneIntl, areaServed: site.areaServed },
  areaServed: site.areaServed,
  description: service.excerpt,
};
---
<Base title={`${service.title} Design in Islamabad — ${service.tagline} | Home Studio Interiors`}
  description={service.excerpt} image={pageHeroImage} jsonLd={jsonLd}>
  <PageHero eyebrow={`Services · ${service.title}`} title={service.tagline} subtitle={service.excerpt} image={pageHeroImage} />

  <section class="container-page page-grid-line py-20 md:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="section-kicker" data-reveal>Design direction</p>
        <h2 class="display-md mt-4 max-w-xl" data-reveal>{service.title} designed around real life.</h2>
        <p class="mt-6 text-lg text-muted" data-reveal>{detail.intro}</p>
      </div>
      <div class="lg:col-span-5">
        <p class="section-kicker" data-reveal>Materials & detail</p>
        <ul class="mt-6 overflow-hidden rounded-[1.4rem] border border-line bg-surface/35" data-reveal>
          {detail.materials.map((m) => (
            <li class="flex items-center gap-3 border-b border-line px-5 py-4 text-sm text-ink last:border-b-0"><span class="h-px w-6 bg-accent"></span>{m}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {hasCollections ? (
    <section class="bg-sand py-24 md:py-32">
      <div class="container-page">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="section-kicker" data-reveal>Complete collection</p>
            <h2 class="display-md mt-4 max-w-3xl" data-reveal>Every {serviceStyleLabel} style from the original collection, redesigned for a richer browsing experience.</h2>
          </div>
          <p class="max-w-md text-sm text-muted lg:col-span-5 lg:justify-self-end" data-reveal>
            Names, descriptions and image groups are drawn from the live {serviceStyleLabel} page, then presented in a darker, more editorial Home Studio layout.
          </p>
        </div>

        <div class="mt-14 space-y-20">
          {detail.collections?.map((group, groupIndex) => (
            <div class="page-grid-line" data-reveal={groupIndex === 0 ? 'left' : 'right'}>
              <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
                <div class="lg:sticky lg:top-28 lg:col-span-4">
                  <div class="rounded-[1.8rem] border border-line bg-bone/65 p-6 backdrop-blur">
                    <p class="section-kicker">{group.label}</p>
                    <h3 class="mt-4 font-display text-3xl leading-tight md:text-4xl">{group.title}</h3>
                  <p class="mt-5 text-sm text-muted">{group.intro}</p>
                  <div class="mt-8 grid grid-cols-3 border-y border-line">
                    <div class="py-4">
                      <span class="number-mark block">Styles</span>
                      <span class="mt-1 block font-display text-2xl text-ink">{group.images.length}</span>
                    </div>
                    <div class="border-x border-line px-4 py-4">
                      <span class="number-mark block">Mood</span>
                      <span class="mt-1 block text-sm text-ink">{groupIndex === 0 ? 'Refined' : 'Timeless'}</span>
                    </div>
                    <div class="pl-4 py-4">
                      <span class="number-mark block">Build</span>
                      <span class="mt-1 block text-sm text-ink">Custom</span>
                    </div>
                  </div>
                    <div class="mt-6 flex flex-wrap gap-2">
                      {group.images.slice(0, 8).map((item) => (
                        <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-white/56">{item.name}</span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="grid gap-5 sm:grid-cols-2 lg:col-span-8">
                  {group.images.map((item, i) => (
                    <article class={`group overflow-hidden rounded-[1.4rem] border border-line bg-bone/35 transition-all duration-500 hover:-translate-y-1 hover:border-accent/45 ${i === 0 ? 'sm:col-span-2' : ''}`}>
                      <button type="button" class="card-hover image-frame block w-full border-0 text-left" data-reveal="img" data-lightbox={item.images[0]} data-lightbox-title={`${item.name} ${service.title} design`}>
                        <img src={item.images[0]} alt={`${item.name} ${group.label.toLowerCase()} by Home Studio Interiors`} loading="lazy"
                          class={`w-full object-cover ${i === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]'}`} />
                        <div class="card-hover-label pointer-events-none absolute inset-0 flex items-end justify-between p-5">
                          <span><span class="number-mark block">{String(i + 1).padStart(2, '0')}</span><span class="mt-1 block font-display text-xl text-white">{item.name}</span></span>
                          <span class="grid h-9 w-9 place-items-center rounded-full bg-accent text-white"><Icon name="arrow" size={15} /></span>
                        </div>
                      </button>
                      <div class="p-5">
                        <div class="flex items-start justify-between gap-4">
                          <h4 class="font-display text-2xl">{item.name}</h4>
                          <span class="number-mark">{String(i + 1).padStart(2, '0')}</span>
                        </div>
                        <p class="mt-3 text-sm leading-7 text-muted">{item.description}</p>
                        {item.images.length > 1 && (
                          <div class="mt-5 grid grid-cols-4 gap-2">
                            {item.images.slice(1).map((thumb) => (
                              <button type="button" data-lightbox={thumb} data-lightbox-title={`${item.name} ${service.title} detail`} class="block">
                                <img src={thumb} alt={`${item.name} ${service.title.toLowerCase()} detail`} loading="lazy" class="aspect-[4/3] w-full rounded-lg border border-line object-cover opacity-80 transition-opacity duration-300 hover:opacity-100" />
                              </button>
                            ))}
                          </div>
                        )}
                        <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Hi Home Studio, I am interested in the ${item.name} ${serviceStyleLabel} design.`)}`} class="btn btn-ghost mt-5 w-full justify-center">Book this design <Icon name="arrow" size={14} class="arrow" /></a>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="bg-sand py-24 md:py-32">
      <div class="container-page">
        <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div><p class="section-kicker" data-reveal>Signature collection</p><h2 class="display-md mt-4" data-reveal>A closer look.</h2></div>
          <p class="max-w-sm text-sm text-muted" data-reveal>Explore the finishes, profiles and moods that shape each {service.title.toLowerCase()} brief.</p>
        </div>
        <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-12">
          {detail.gallery.map((g, i) => (
            <button type="button" class={`card-hover group image-frame text-left ${i === 0 ? 'sm:col-span-2 lg:col-span-7 lg:row-span-2' : 'lg:col-span-5'}`} data-reveal="img" data-lightbox={g} data-lightbox-title={`${service.title} project by Home Studio Interiors`}>
              <img src={g} alt={`${service.title} project by Home Studio Interiors`} loading="lazy"
                class={`w-full object-cover ${i === 0 ? 'aspect-[4/3] h-full lg:aspect-auto lg:min-h-[38rem]' : 'aspect-[4/3]'}`} />
              <div class="card-hover-label pointer-events-none absolute inset-0 flex items-end justify-between p-5">
                <span><span class="number-mark block">{String(i + 1).padStart(2, '0')}</span><span class="mt-1 block font-display text-xl text-white">{collection[i] ?? service.title}</span></span>
                <span class="grid h-9 w-9 place-items-center rounded-full bg-accent text-white"><Icon name="arrow" size={15} /></span>
              </div>
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  {detail.video && (
    <section class="container-page py-16 md:py-24">
      <div class="grid gap-8 rounded-[1.8rem] border border-line bg-surface/45 p-6 md:p-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="section-kicker" data-reveal>Studio reel</p>
          <h2 class="display-md mt-4" data-reveal>{detail.video.title}</h2>
          <p class="mt-5 max-w-xl text-sm leading-7 text-muted" data-reveal>{detail.video.description}</p>
          <p class="mt-4 text-xs leading-6 text-muted" data-reveal>Video is optional and loads only when you press play.</p>
        </div>
        <div class="lg:col-span-5 lg:justify-self-end" data-reveal>
          <video
            controls
            playsinline
            preload="none"
            poster={detail.video.poster}
            aria-label={detail.video.title}
            class="mx-auto aspect-[9/16] max-h-[34rem] w-full max-w-[19rem] rounded-[1.4rem] border border-line bg-black object-cover"
          >
            <source src={detail.video.src} type="video/mp4" />
            Your browser does not support embedded video.
          </video>
        </div>
      </div>
    </section>
  )}

  <!-- Other services -->
  <section class="container-page py-24 md:py-32">
    <div class="flex items-end justify-between">
      <h2 class="display-md" data-reveal>Explore more services</h2>
      <a href="/services" class="link-underline text-sm uppercase tracking-[0.16em]" data-reveal>All services →</a>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {others.map((s) => (
        <a href={`/services/${s.slug}`} class="group block" data-reveal>
          <div class="aspect-[4/5] overflow-hidden">
            <img src={s.image} alt={s.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105" />
          </div>
          <h3 class="mt-4 font-display text-2xl">{s.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <CtaBand title={`Planning a new ${serviceStyleLabel}?`} />
</Base>
