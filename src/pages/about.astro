---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { stats, processSteps, differentiators, aboutImage, heroImage, materialHighlights } from '../data/site';
---
<Base title="About — Home Studio Interiors | Interior Design Studio in Islamabad"
  description="A residential interior design studio in Islamabad & Rawalpindi. Eight years of craft, 2,488+ homes delivered, and one accountable team from concept to handover.">
  <PageHero eyebrow="About the studio" title="Designing spaces that define you."
    subtitle="A residential interior design studio in Islamabad — blending smart planning with warm materials to create homes that feel effortless and endure."
    image={heroImage} />

  <section class="container-page py-20 md:py-28">
    <div class="grid items-center gap-16 lg:grid-cols-2">
      <div data-reveal="img" class="image-frame rounded-[1.8rem] p-2">
        <img src={aboutImage} alt="Contemporary living room interior by Home Studio Interiors" loading="lazy" class="h-[34rem] w-full rounded-[1.35rem] object-cover" />
      </div>
      <div>
        <p class="section-kicker" data-reveal>Who we are</p>
        <h2 class="display-md mt-4" data-reveal>Creativity, met with practicality.</h2>
        <p class="mt-6 text-muted" data-reveal>At Home Studio Interiors we blend smart planning with warm materials to create homes built for daily life. With over eight years shaping interiors across Islamabad and Rawalpindi, we pair local craftsmanship with modern detail and accountable project management.</p>
        <p class="mt-4 text-muted" data-reveal>From modular kitchens and custom wardrobes to vanities, doors and media walls, one team carries your project from first sketch to final handover — with 3D visualisation, an itemised BOQ and a one-year workmanship warranty.</p>
        <div class="mt-8 grid gap-3 sm:grid-cols-2" data-reveal>
          {['Transparent BOQ', 'Weekly updates', '3D visualisation', 'Turnkey handover'].map((x) => (
            <div class="flex items-center gap-3 rounded-full border border-line px-4 py-3 text-sm text-white/72"><Icon name="check" size={16} class="text-accent" />{x}</div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-20 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="spotlight rounded-[1.3rem] border border-line bg-surface/45 p-6" data-reveal>
          <p class="font-display text-5xl text-ink">{s.value}</p>
          <p class="mt-2 text-xs uppercase tracking-[0.16em] text-muted">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand py-20 md:py-28">
    <div class="container-page">
      <p class="section-kicker" data-reveal>Our philosophy</p>
      <h2 class="display-lg mt-4 max-w-3xl" data-reveal>Calm, functional interiors that inspire and endure.</h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {differentiators.map((d) => (
          <div class="lux-card rounded-[1.3rem] p-6" data-reveal>
            <h3 class="font-display text-2xl">{d.title}</h3>
            <p class="mt-3 text-sm text-muted">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-20 md:py-28">
    <p class="section-kicker" data-reveal>How we work</p>
    <h2 class="display-lg mt-4 max-w-3xl" data-reveal>A calm, transparent process.</h2>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {processSteps.map((step) => (
        <div class="spotlight rounded-[1.4rem] border border-line bg-surface/45 p-6" data-reveal>
          <p class="font-display text-5xl text-accent">{step.no}</p>
          <h3 class="mt-4 font-display text-2xl">{step.title}</h3>
          <p class="mt-3 text-sm text-muted">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-sand py-20 md:py-28">
    <div class="container-page">
      <p class="section-kicker" data-reveal>Material mindset</p>
      <h2 class="display-md mt-4 max-w-3xl" data-reveal>We specify finishes for beauty, durability and daily use.</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {materialHighlights.map((m) => (
          <div class="material-chip rounded-[1.25rem] border border-line p-5" data-reveal>
            <h3 class="font-display text-2xl">{m.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
