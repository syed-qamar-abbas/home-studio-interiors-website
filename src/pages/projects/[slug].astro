---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { caseStudies, site } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const pageUrl = `${site.url}/projects/${study.slug}`;
const whatsappText = `Hi Home Studio, I reviewed the ${study.title} case study and want to discuss a similar ${study.service} project.`;
const locationLabel = study.location || 'Not specified in supplied material';
const pageDescriptor = study.stage || 'Project case study';
const relatedStudies = caseStudies
  .filter((item) => item.slug !== study.slug)
  .sort((a, b) => {
    const score = (item) => (item.service === study.service ? 2 : 0) + (study.location && item.location === study.location ? 1 : 0);
    return score(b) - score(a);
  })
  .slice(0, 3);
const caseStudyJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': `${pageUrl}/#case-study`,
  name: `${study.title} case study`,
  headline: `${study.title} — ${study.service}${study.location ? ` in ${study.location}` : ''}`,
  description: study.summary,
  url: `${pageUrl}/`,
  inLanguage: 'en-PK',
  about: [
    { '@type': 'Thing', name: study.service },
    ...(study.location ? [{ '@type': 'Place', name: study.location }] : []),
  ],
  creator: { '@id': `${site.url}/#business` },
  publisher: { '@id': `${site.url}/#business` },
  image: (study.images.length ? study.images : [study.cover]).map((image) => new URL(image, site.url).href),
  ...(study.video ? {
    video: {
      '@type': 'VideoObject',
      name: study.video.title,
      description: study.video.description,
      contentUrl: new URL(study.video.src, site.url).href,
      thumbnailUrl: new URL(study.video.poster, site.url).href,
    },
  } : {}),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects/` },
    { '@type': 'ListItem', position: 3, name: study.title, item: `${pageUrl}/` },
  ],
};
---

<Base
  title={`${study.title} | Home Studio Interiors`}
  description={study.summary}
  image={study.cover}
  path={`/projects/${study.slug}/`}
  jsonLd={[caseStudyJsonLd, breadcrumbJsonLd]}
>
  <section class="relative overflow-hidden border-b border-line bg-graphite pt-28 md:pt-32">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(242,112,37,0.16),transparent_32%),radial-gradient(circle_at_80%_0%,rgba(255,255,255,0.08),transparent_28%)]"></div>
    <div class="container-page relative grid gap-10 pb-16 md:pb-20 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <nav aria-label="Breadcrumb" class="mb-8 text-xs tracking-wide text-white/65" data-reveal>
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="transition-colors hover:text-accent">Home</a></li>
            <li aria-hidden="true" class="text-white/35">/</li>
            <li><a href="/projects/" class="transition-colors hover:text-accent">Projects</a></li>
            <li aria-hidden="true" class="text-white/35">/</li>
            <li aria-current="page" class="text-white/85">{study.title}</li>
          </ol>
        </nav>
        <p class="section-kicker" data-reveal>{pageDescriptor}</p>
        <h1 class="display-lg mt-5 max-w-[15ch]" data-reveal>{study.title} <span class="text-accent">, {study.service}</span></h1>
        <p class="mt-6 max-w-3xl text-base leading-8 text-muted md:text-lg" data-reveal>{study.summary}</p>
        {study.sourceNote && <p class="mt-4 max-w-3xl border-l border-accent/60 pl-4 text-sm leading-6 text-muted" data-reveal>{study.sourceNote}</p>}
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(whatsappText)}`} class="btn btn-primary">Discuss similar project</a>
          <a href={study.serviceHref} class="btn btn-ghost">View related service</a>
        </div>
      </div>
      <div class="signature-card rounded-[1.5rem] border border-white/12 bg-surface/75 p-3 sm:p-4 lg:col-span-5" data-reveal>
        <img src={study.cover} alt={`${study.title} — ${study.service}${study.location ? ` in ${study.location}` : ''}`} class="aspect-[4/5] w-full rounded-[1.1rem] object-cover" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-24">
    <div class="grid gap-5 md:grid-cols-4">
      {[
        ['Location', locationLabel],
        ['Scope', study.service],
        ['Evidence', study.video ? (study.images.length ? 'Carousel + reel' : 'Project reel') : study.images.length ? 'Project carousel' : 'Design image'],
        ['Lead action', 'WhatsApp quote'],
      ].map(([label, value]) => (
        <div class="rounded-[1.3rem] border border-line bg-surface/55 p-5" data-reveal>
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent">{label}</p>
          <p class="mt-3 font-display text-2xl text-white">{value}</p>
        </div>
      ))}
    </div>

    {study.video && (
      <section class="mt-14 grid gap-8 rounded-[1.8rem] border border-line bg-surface/45 p-6 md:p-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="section-kicker" data-reveal>Project reel</p>
          <h2 class="display-md mt-4" data-reveal>{study.video.title}</h2>
          <p class="mt-5 max-w-xl text-sm leading-7 text-muted" data-reveal>{study.video.description}</p>
          <p class="mt-4 text-xs leading-6 text-muted" data-reveal>Press play to load the locally hosted, compressed video.</p>
        </div>
        <div class="lg:col-span-5 lg:justify-self-end" data-reveal>
          <video
            controls
            playsinline
            preload="none"
            poster={study.video.poster}
            aria-label={study.video.title}
            class="mx-auto aspect-[9/16] max-h-[38rem] w-full max-w-[21rem] rounded-[1.4rem] border border-line bg-black object-cover"
          >
            <source src={study.video.src} type="video/mp4" />
            Your browser does not support embedded video.
          </video>
        </div>
      </section>
    )}

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="section-kicker" data-reveal>What this shows</p>
        <h2 class="display-sm mt-5" data-reveal>Clear project evidence for homeowners comparing interior styles.</h2>
        <p class="mt-5 text-sm leading-7 text-muted" data-reveal>
          This case-study page keeps the original carousel visuals together so visitors and AI systems can understand the project location, service scope and design direction without guessing.
        </p>
        <ul class="mt-7 space-y-3">
          {study.proof.map((item) => (
            <li class="flex gap-3 text-sm leading-6 text-muted" data-reveal>
              <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-accent/40 text-accent"><Icon name="check" size={12} /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-8">
        <div class="grid gap-5 sm:grid-cols-2">
          {study.images.map((image, index) => (
            <button type="button" data-lightbox={image} data-lightbox-title={`${study.title} slide ${index + 1}`} class="card-hover image-frame block rounded-[1.4rem]" data-reveal="img">
              <img
                src={image}
                alt={`${study.title} — ${study.service}${study.location ? ` in ${study.location}` : ''}, image ${index + 1}`}
                loading={index < 2 ? 'eager' : 'lazy'}
                class="aspect-[4/5] w-full object-cover"
              />
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sand py-16 md:py-24">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-8">
        <p class="section-kicker" data-reveal>Answer for visitors</p>
          <h2 class="display-md mt-5 text-ink" data-reveal>{study.stage === 'Design study' || study.stage === 'Design concept' ? 'How can this design direction be adapted?' : study.stage === 'In progress' || study.stage === 'Installation in progress' ? 'What does this project update show?' : 'Can Home Studio Interiors handle similar projects?'}</h2>
        <p class="mt-6 max-w-3xl text-base leading-8 text-black/70" data-reveal>
          {study.answer || `Home Studio Interiors works with homeowners across Islamabad and Rawalpindi on kitchens, wardrobes, vanities, media walls, doors and full-home remodeling. Share this project page on WhatsApp to discuss whether a similar brief fits your space and requirements.`}
        </p>
      </div>
      <div class="lg:col-span-4 lg:text-right" data-reveal>
        <a href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(whatsappText)}`} class="btn btn-primary">{study.cta}</a>
      </div>
    </div>
  </section>

  <section class="container-page py-16 md:py-20" aria-labelledby="related-projects-heading">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="section-kicker" data-reveal>Continue exploring</p>
        <h2 id="related-projects-heading" class="display-sm mt-4" data-reveal>Related project stories</h2>
      </div>
      <a href="/projects/" class="link-underline text-xs uppercase tracking-[0.16em] text-white/70 hover:text-accent">View all projects →</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {relatedStudies.map((related) => (
        <article class="signature-card overflow-hidden rounded-[1.3rem] border border-line bg-surface/55" data-reveal>
          <a href={`/projects/${related.slug}/`} class="image-frame block">
            <img src={related.cover} alt={`${related.title} — ${related.service}${related.location ? ` in ${related.location}` : ''}`} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
          </a>
          <div class="p-5">
            <p class="text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-accent">{related.stage || 'Project case study'} · {related.service}</p>
            <h3 class="mt-2 font-display text-xl text-white"><a href={`/projects/${related.slug}/`} class="transition-colors hover:text-accent">{related.title}</a></h3>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBand title="Want this direction adapted to your home?" text="Send us the case study you like and we’ll guide you on layouts, materials and a quotation path for your own space." />
</Base>
