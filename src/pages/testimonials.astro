---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { testimonials, site, heroImage, projectPortfolio } from '../data/site';
---
<Base title="Client Testimonials — Home Studio Interiors, Islamabad"
  description="Real feedback from homeowners across Islamabad & Rawalpindi — clear communication, on-time delivery and beautiful results from a trusted interior designer.">
  <PageHero eyebrow="Client stories" title="What our clients say."
    subtitle={`Real feedback from homeowners across Islamabad & Rawalpindi. Rated ${site.rating.value} of 5 from ${site.rating.count}+ reviews.`}
    image={heroImage} />

  <section class="container-page py-20 md:py-28">
    <div class="grid gap-6 md:grid-cols-2">
      {testimonials.map((t, i) => (
        <blockquote class="spotlight rounded-[1.6rem] border border-line bg-surface/45 p-7" data-reveal>
          <p class="text-accent">★★★★★</p>
          <p class="mt-4 font-display text-2xl leading-snug text-ink md:text-3xl">“{t.quote}”</p>
          <footer class="mt-6 text-sm uppercase tracking-[0.14em] text-muted">{t.name} · <span class="text-accent">{t.place}</span></footer>
          <div class="mt-6 overflow-hidden rounded-2xl border border-line">
            <img src={projectPortfolio[i % projectPortfolio.length].image} alt="" loading="lazy" class="h-44 w-full object-cover" />
          </div>
        </blockquote>
      ))}
    </div>
  </section>

  <section class="bg-sand py-20 md:py-28">
    <div class="container-page grid gap-8 lg:grid-cols-3">
      {[
        ['Transparent BOQ', 'Clients know the budget and scope before site work begins.'],
        ['Weekly Updates', 'Regular progress, decisions and quality checks during execution.'],
        ['Aftercare', 'Warranty support after handover for peace of mind.'],
      ].map(([title, text]) => (
        <div class="lux-card rounded-[1.4rem] p-6" data-reveal>
          <Icon name="check" size={22} class="text-accent" />
          <h2 class="mt-5 font-display text-2xl">{title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <CtaBand title="Join 2,488+ happy homeowners." />
</Base>
