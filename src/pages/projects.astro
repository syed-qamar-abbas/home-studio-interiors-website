---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { featuredProjects, galleryImages, heroImage } from '../data/site';
---
<Base title="Projects — Interior Design Portfolio in Islamabad & Rawalpindi | Home Studio Interiors"
  description="Recent interior transformations across Islamabad & Rawalpindi — kitchens, wardrobes, vanities, media walls and full-home fit-outs by Home Studio Interiors.">
  <PageHero eyebrow="Selected work" title="Recent transformations."
    subtitle="A selection of kitchens, wardrobes, doors, vanities and media walls — balanced for style, function and comfort across Islamabad & Rawalpindi."
    image={heroImage} />

  <!-- Featured -->
  <section class="container-page py-24 md:py-32">
    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.slice(0, 4).map((p, i) => (
        <a href="/contact" class={`group relative block overflow-hidden ${i % 3 === 0 ? 'md:col-span-2' : ''}`} data-reveal="img">
          <div class={i % 3 === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]'}>
            <img src={p.image} alt={p.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-[1.3s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105" />
          </div>
          <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-graphite/80 to-transparent p-8 text-white opacity-0 transition-opacity duration-500 group-hover:opacity-100">
            <p class="text-xs uppercase tracking-[0.2em] text-accent">{p.tag}</p>
            <h3 class="font-display text-3xl">{p.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Full gallery -->
  <section class="bg-sand py-24 md:py-32">
    <div class="container-page">
      <p class="eyebrow" data-reveal>The gallery</p>
      <h2 class="display-md mt-4" data-reveal>Details, finishes & moments.</h2>
      <div class="mt-14 columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6">
        {galleryImages.map((img) => (
          <div class="overflow-hidden break-inside-avoid" data-reveal="img">
            <img src={img} alt="Interior design detail by Home Studio Interiors" loading="lazy"
              class="w-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.04]" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Imagine your space, transformed." />
</Base>
